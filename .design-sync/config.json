    },
    "HistogramChart": {
      "cardMode": "column"
    },
    "HorizontalBarChart": {
      "cardMode": "column",
      "skip": [
        "design-components-horizontalbarchart--category-colors",
        "design-components-horizontalbarchart--long-and-duplicate-labels",
        "design-components-horizontalbarchart--many-rows",
        "design-components-horizontalbarchart--side-tooltip"
      ]

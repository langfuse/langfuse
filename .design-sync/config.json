{
  "projectId": "31adc942-7274-47d3-8b86-cc9a1ec5e652",
  "shape": "storybook",
  "storybookConfigDir": "web/.storybook",
  "pkg": "@langfuse/design-system",
  "globalName": "LangfuseDS",
  "entry": ".design-sync/ds-package/index.ts",
  "tsconfig": "tsconfig.json",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": ".design-sync/ds-package/gen-entry.sh && (cd web && npx dotenv -e ../.env.dev.example -- npx storybook build -c .storybook -o \"$(git rev-parse --show-toplevel)/.design-sync/sb-reference\") && .design-sync/ds-package/copy-css.sh",
  "libOverrides": {
    "dts.mjs": "DS ships TS source (no dist/): resolve web @/* paths, @types/react from web/node_modules, in-package = web/src/components/design-system/",
    "story-imports.mjs": "Storybook 10 CSF factories: redirect web/.storybook/preview imports to ds-package/csf-factories-preview.tsx (flattens preview.meta().story() to CSF3)"
  },
  "cssEntry": "storybook-compiled.css",
  "provider": {
    "component": "LangfuseProvider"
  },
  "overrides": {
    "Table": {
      "cardMode": "single",
      "primaryStory": "Default",
      "skip": [
        "design-components-table--sorting",
        "design-components-table--resize-columns"
      ]
    },
    "Button": {
      "skip": [
        "playground-button--default",
        "playground-button--disabled",
        "playground-button--keyboard-focus",
        "playground-button--loading",
        "playground-button--loading-with-text",
        "playground-button--variant-matrix",
        "playground-button--with-icon"
      ]
    },
    "Alert": {
      "cardMode": "column"
    },
    "AreaChart": {
      "cardMode": "column",
      "skip": [
        "design-components-areachart--highlight-legend",
        "design-components-areachart--stacked-areas"
      ]
    },
    "BarChart": {
      "cardMode": "column"
    },
    "GroupedBarChart": {
      "cardMode": "column",
      "skip": [
        "design-components-groupedbarchart--side-by-side"

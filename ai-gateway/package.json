{
  "name": "ai-gateway",
  "private": true,
  "scripts": {
    "dev": "node init && dotenv -e ../.env -v LANGFUSE_AI_GATEWAY_AUTO_INCREMENT_LISTEN_PORT=true -- bash scripts/run-dev.sh",
    "build": "node init && cargo build --release --locked",
    "build:dev": "node init && cargo build --locked",
    "typecheck": "cargo check --locked --all-targets",
    "lint": "cargo fmt --all -- --check && cargo clippy --locked --all-targets -- -D warnings",
    "test": "cargo test --locked",
    "format": "cargo fmt --all"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4"
  }
}

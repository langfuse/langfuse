# Interpolation file for the e2e stack, passed with `--env-file`. It replaces
# the repository-root .env, whose host-facing localhost URLs and Langfuse
# Cloud region would break the containers (and the region is baked into the
# web image at build time). Leave it empty so docker-compose.build.yml uses
# its container-network defaults; self-hosted mode needs the region unset.
NEXT_PUBLIC_LANGFUSE_CLOUD_REGION=

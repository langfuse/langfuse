{
  "name": "@langfuse/native",
  "version": "0.0.0",
  "description": "Rust native addon (napi-rs) loaded by the Langfuse worker",
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "pnpm run rust:build",
    "rust:build": "node scripts/remove-generated-cargo-patch.mjs && napi build --platform --release",
    "build:debug": "pnpm run rust:build:debug",
    "rust:build:debug": "node scripts/remove-generated-cargo-patch.mjs && napi build --platform",
    "lint": "pnpm run rust:lint",
    "rust:lint": "node scripts/remove-generated-cargo-patch.mjs && cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "lint:fix": "pnpm run rust:lint:fix",
    "rust:lint:fix": "node scripts/remove-generated-cargo-patch.mjs && cargo fmt && cargo clippy --all-targets --fix --allow-dirty -- -D warnings",
    "test": "pnpm run rust:test",
    "rust:test": "node scripts/remove-generated-cargo-patch.mjs && cargo test --locked --features napi/dyn-symbols",
    "rust:deny": "node scripts/remove-generated-cargo-patch.mjs && cargo deny --locked check",
    "rust:unused-deps": "node scripts/remove-generated-cargo-patch.mjs && cargo machete"
  },
  "napi": {
    "binaryName": "langfuse-native",
    "targets": [
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6"
  }
}

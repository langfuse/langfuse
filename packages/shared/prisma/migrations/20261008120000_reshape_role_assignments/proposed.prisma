// Replace RoleAssignment in schema.prisma when applying cleanup.proposed.sql.
// Also remove deprecatedRoleAssignments from User, Organization, Project, and ApiKey.

model RoleAssignment {
  id           String       @id @default(cuid())
  ownerId      String       @map("owner_id")
  projectId    String?      @map("project_id")
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  orgId        String       @map("org_id")
  organization Organization @relation("RoleAssignmentTenant", fields: [orgId], references: [id], onDelete: Cascade)
  principalId  String       @map("principal_id")
  userId       String?      @map("user_id")
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId     String?      @map("api_key_id")
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  roleId       String       @map("role_id")
  systemRole   SystemRole   @map("system_role")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  @@unique([roleId, principalId, ownerId])
  @@index([orgId])
  @@index([projectId])
  @@index([principalId])
  @@index([userId])
  @@index([apiKeyId])
  @@map("role_assignments")
}

exports[`golden: executeQuery v2 traces > measures > buildEventsTraces measure=latency agg=avg 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",

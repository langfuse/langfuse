exports[`golden: executeQuery v2 traces > crosses > buildEventsTraces filter=metadata-full bucket=time level=two 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "region",
      "param3": "%eu%",
      "param4": "eu",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        ifNull(
            anyIf(toNullable(toDate(e.start_time)), ((e.parent_span_id = '') OR (e.is_app_root = true))),
            min(toDate(e.start_time))
        ) AS time_dimension,
        uniq(e.trace_id) AS count
    FROM events_full AS e
    WHERE (e.project_id = {param1:String})
        AND has(e.metadata_names, {param2:String})
        AND like(arrayStringConcat(e.metadata_values), {param3:String})
        AND (position(e.metadata_values[indexOf(e.metadata_names, {param2:String})], {param4:String}) > 0)
        AND (e.start_time >= {param5:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param6:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param5:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param6:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param5:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param6:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param5:DateTime64(3, 'UTC')}) TO toDate({param6:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;

exports[`golden: executeQuery v2 traces > crosses > buildEventsTraces measure=scoresCount bucket=time 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    sum(scoresCount) AS sum_scoresCount
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        ifNull(
            anyIf(toNullable(toDate(e.start_time)), ((e.parent_span_id = '') OR (e.is_app_root = true))),
            min(toDate(e.start_time))
        ) AS time_dimension,
        uniq(scores.id) AS scoresCount
    FROM events_core AS e
    INNER JOIN scores
    FINAL ON (
        (e.trace_id = scores.trace_id) AND (e.project_id = scores.project_id)
    ) AND (scores.project_id = {param1:String})
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param2:DateTime64(3, 'UTC')}) TO toDate({param3:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;


exports[`golden: executeQuery v2 traces > bucketing > buildEventsTraces bucket=time fill=skipped-overflow 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "1969-12-31 00:00:00.000",
      "param3": "1970-01-02 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        ifNull(
            anyIf(toNullable(toDate(e.start_time)), ((e.parent_span_id = '') OR (e.is_app_root = true))),
            min(toDate(e.start_time))
        ) AS time_dimension,
        uniq(e.trace_id) AS count
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
GROUP BY time_dimension
ORDER BY time_dimension ASC",
  },
]
`;

exports[`golden: executeQuery v2 traces > bucketing > buildEventsTraces bucket=time granularity=1d 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        ifNull(
            anyIf(
                toNullable(toStartOfInterval(e.start_time, toIntervalDay(1))),
                ((e.parent_span_id = '') OR (e.is_app_root = true))
            ),
            min(toStartOfInterval(e.start_time, toIntervalDay(1)))
        ) AS time_dimension,
        uniq(e.trace_id) AS count
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toStartOfInterval({param2:DateTime64(3, 'UTC')}, toIntervalDay(1)) TO toStartOfInterval({param3:DateTime64(3, 'UTC')}, toIntervalDay(1)) STEP toIntervalDay(1)",
  },
]
`;


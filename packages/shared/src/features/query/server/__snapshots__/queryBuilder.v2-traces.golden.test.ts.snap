exports[`golden: executeQuery v2 traces > crosses > buildEventsTraces filter=metadata-full bucket=time level=two 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "region",
      "param10": "2026-01-01 00:00:00.000",
      "param11": "2026-01-04 00:00:00.000",
      "param2": "%eu%",
      "param3": "eu",
      "param4": "golden-project",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-04 00:00:00.000",
      "param7": "golden-project",
      "param8": "2026-01-01 00:00:00.000",
      "param9": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        events_full.project_id,
        events_traces.trace_id,
        ifNull(
            anyIf(
                toNullable(toDate(events_full.start_time)),
                ((events_traces.parent_span_id = '') OR (events_traces.is_app_root = true))
            ),
            min(toDate(events_full.start_time))
        ) AS time_dimension,
        uniq(events_traces.trace_id) AS count
    FROM events_full AS events_traces
    WHERE has(events_full.metadata_names, {param1:String})
        AND like(arrayStringConcat(events_full.metadata_values), {param2:String})
        AND (position(events_full.metadata_values[indexOf(events_full.metadata_names, {param1:String})], {param3:String}) > 0)
        AND (events_full.project_id = {param4:String})
        AND (events_full.start_time >= {param5:DateTime64(3, 'UTC')})
        AND (events_full.start_time <= {param6:DateTime64(3, 'UTC')})
        AND ((events_full.trace_id IN (
            SELECT events_traces.trace_id
            FROM events_full AS events_traces
            WHERE (events_traces.project_id = {param7:String})
                AND ((events_traces.parent_span_id = '') OR (events_traces.is_app_root = true))
                AND (events_traces.start_time >= {param8:DateTime64(3, 'UTC')})
                AND (events_traces.start_time <= {param9:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT events_traces.trace_id
            FROM events_full AS events_traces
            WHERE (events_traces.project_id = {param7:String})
                AND ((events_traces.parent_span_id = '') OR (events_traces.is_app_root = true))
                AND (events_traces.start_time >= {param8:DateTime64(3, 'UTC')})
                AND (events_traces.start_time <= {param9:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        events_full.project_id,
        events_traces.trace_id
)
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param10:DateTime64(3, 'UTC')}) TO toDate({param11:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;

exports[`golden: executeQuery v2 traces > crosses > buildEventsTraces measure=scoresCount bucket=time 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param10": "2026-01-04 00:00:00.000",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",
      "param4": "2026-01-01 00:00:00.000",
      "param5": "2026-01-04 00:00:00.000",
      "param6": "golden-project",
      "param7": "2026-01-01 00:00:00.000",
      "param8": "2026-01-04 00:00:00.000",
      "param9": "2026-01-01 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    sum(scoresCount) AS sum_scoresCount
FROM
(
    SELECT
        events_core.project_id,
        events_traces.trace_id,
        ifNull(
            anyIf(
                toNullable(toDate(events_core.start_time)),
                ((events_traces.parent_span_id = '') OR (events_traces.is_app_root = true))
            ),
            min(toDate(events_core.start_time))
        ) AS time_dimension,
        uniq(scores.id) AS scoresCount
    FROM events_core AS events_traces
    INNER JOIN scores
    FINAL ON (events_traces.trace_id = scores.trace_id) AND (events_traces.project_id = scores.project_id)
    WHERE (events_core.project_id = {param1:String})
        AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
        AND (scores.timestamp >= {param4:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param5:DateTime64(3, 'UTC')})
        AND ((events_core.trace_id IN (
            SELECT events_traces.trace_id
            FROM events_core AS events_traces
            WHERE (events_traces.project_id = {param6:String})
                AND ((events_traces.parent_span_id = '') OR (events_traces.is_app_root = true))
                AND (events_traces.start_time >= {param7:DateTime64(3, 'UTC')})
                AND (events_traces.start_time <= {param8:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT events_traces.trace_id
            FROM events_core AS events_traces
            WHERE (events_traces.project_id = {param6:String})
                AND ((events_traces.parent_span_id = '') OR (events_traces.is_app_root = true))
                AND (events_traces.start_time >= {param7:DateTime64(3, 'UTC')})
                AND (events_traces.start_time <= {param8:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        events_core.project_id,
        events_traces.trace_id
)
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param9:DateTime64(3, 'UTC')}) TO toDate({param10:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;


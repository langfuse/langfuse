exports[`golden: executeQuery v2 traces > dimensions > buildEventsTraces level=two dim=name 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",

exports[`golden: executeQuery v2 traces > levels > buildEventsTraces level=single metrics=none dims=id bucket=time 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    e.trace_id AS id,
    toDate(e.start_time) AS time_dimension,
    count(*) AS count
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
    AND ((e.trace_id IN (
        SELECT e.trace_id
        FROM events_core AS e
        WHERE (e.project_id = {param1:String})
            AND ((e.parent_span_id = '') OR (e.is_app_root = true))
            AND (e.start_time >= {param2:DateTime64(3, 'UTC')})

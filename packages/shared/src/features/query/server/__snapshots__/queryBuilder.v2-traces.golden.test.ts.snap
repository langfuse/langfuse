// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden: executeQuery v2 traces > aggregations > buildEventsTraces agg=histogram bins=25 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT histogram(25)(toFloat64(latency)) AS histogram_latency
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        dateDiff(
            'millisecond',
            minIf(e.start_time, e.parent_span_id != ''),
            maxIf(e.end_time, e.parent_span_id != '')
        ) AS latency
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
ORDER BY histogram_latency DESC",
  },
]
`;

exports[`golden: executeQuery v2 traces > aggregations > buildEventsTraces agg=p95 bins=25 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT quantile(0.95)(latency) AS p95_latency
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        dateDiff(
            'millisecond',
            minIf(e.start_time, e.parent_span_id != ''),
            maxIf(e.end_time, e.parent_span_id != '')
        ) AS latency
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
ORDER BY p95_latency DESC",
  },
]
`;

exports[`golden: executeQuery v2 traces > bucketing > buildEventsTraces bucket=entity field=id level=two 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    entity_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        any(e.trace_id) AS entity_dimension,
        uniq(e.trace_id) AS count
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
GROUP BY entity_dimension
ORDER BY count_count DESC",
  },
]
`;


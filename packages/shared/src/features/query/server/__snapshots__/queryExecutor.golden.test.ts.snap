exports[`golden: metrics v2 executeQuery > scores-categorical > filter observationName 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "golden-observation-name",
      "param3": "2026-01-01 00:00:00.000",
      "param4": "2026-01-02 00:00:00.000",
      "param5": "CATEGORICAL",
    },
    "route": "unknown",
    "sql": "SELECT count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores.id,
        count(1) AS count
    FROM scores
    FINAL
    INNER JOIN events_core AS e ON (scores.project_id = e.project_id) AND (scores.trace_id = e.trace_id) AND (scores.observation_id = e.span_id) AND (e.project_id = {param1:String})
    WHERE (scores.project_id = {param1:String})
        AND (e.name = {param2:String})
        AND (scores.timestamp >= {param3:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param4:DateTime64(3, 'UTC')})
        AND (scores.data_type = {param5:String})
        AND (e.start_time >= {param3:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param4:DateTime64(3, 'UTC')})
    GROUP BY
        scores.project_id,
        scores.id
) AS per_score
ORDER BY count_count DESC",
  },
]
`;


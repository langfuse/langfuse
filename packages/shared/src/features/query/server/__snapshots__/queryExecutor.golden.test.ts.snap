exports[`golden: SQL-text executeQuery options > histogram bins > two-level 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "generation",
      "param2": "golden-project",
      "param3": "2026-01-01 00:00:00.000",
      "param4": "2026-01-02 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT histogram(20)(toFloat64(totalCost)) AS histogram_totalCost
FROM
(
    SELECT
        observations.project_id,
        observations.id,
        sum(total_cost) AS totalCost
    FROM observations
    FINAL
    WHERE (observations.type = {param1:String})
        AND (observations.project_id = {param2:String})
        AND (observations.start_time >= {param3:DateTime64(3, 'UTC')})
        AND (observations.start_time <= {param4:DateTime64(3, 'UTC')})
    GROUP BY
        observations.project_id,
        observations.id
)
ORDER BY histogram_totalCost DESC",
  },
]
`;

exports[`golden: SQL-text executeQuery options > root-event window > threshold 0 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2025-01-01 00:00:00.000",
      "param3": "2026-01-01 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    name AS name,
    count(count) AS count_count
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        coalesce(
            nullIf(argMaxIf(e.trace_name, e.event_ts, e.trace_name != ''), ''),
            nullIf(
                argMaxIf(e.name, e.event_ts, (((e.parent_span_id = '') OR (e.is_app_root = true)) AND (e.name != ''))),
                ''
            )
        ) AS name,
        uniq(e.trace_id) AS count
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
GROUP BY name
ORDER BY count_count DESC",
  },
]
`;


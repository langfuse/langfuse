    AND (scores.project_id = {param2:String})
    AND (scores.timestamp >= {param3:DateTime64(3, 'UTC')})
    AND (scores.timestamp <= {param4:DateTime64(3, 'UTC')})
    AND (scores_categorical.data_type = {param5:String})
ORDER BY count_count DESC",
  },
]
`;

exports[`golden: metrics v2 executeQuery > scores-categorical > filter observationName 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-observation-name",
      "param2": "golden-project",
      "param3": "2026-01-01 00:00:00.000",
      "param4": "2026-01-02 00:00:00.000",
      "param5": "CATEGORICAL",
      "param6": "2026-01-01 00:00:00.000",
      "param7": "2026-01-02 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores_categorical.id,
        count(1) AS count
    FROM scores AS scores_categorical
    FINAL
    INNER JOIN events_core AS events_observations ON (scores.project_id = events_observations.project_id) AND (scores.trace_id = events_observations.trace_id) AND (scores.observation_id = events_observations.span_id)
    WHERE (events_observations.name = {param1:String})
        AND (scores.project_id = {param2:String})
        AND (scores.timestamp >= {param3:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param4:DateTime64(3, 'UTC')})
        AND (scores_categorical.data_type = {param5:String})
        AND (events_observations.start_time >= {param6:DateTime64(3, 'UTC')})
        AND (events_observations.start_time <= {param7:DateTime64(3, 'UTC')})
    GROUP BY
        scores.project_id,
        scores_categorical.id
)
ORDER BY count_count DESC",
  },
]
`;


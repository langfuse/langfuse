                AND ((events_traces.parent_span_id = '') OR (events_traces.is_app_root = true))
                AND (events_traces.start_time >= {param6:DateTime64(3, 'UTC')})
                AND (events_traces.start_time <= {param7:DateTime64(3, 'UTC')})
        )) OR (NOT exists((

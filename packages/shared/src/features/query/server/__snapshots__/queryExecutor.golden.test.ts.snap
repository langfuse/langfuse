exports[`golden: SQL-text executeQuery options > root-event window > window below the threshold 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-04 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    name AS name,
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        e.project_id,
        e.trace_id,
        coalesce(
            nullIf(argMaxIf(e.trace_name, e.event_ts, e.trace_name != ''), ''),
            nullIf(
                argMaxIf(e.name, e.event_ts, (((e.parent_span_id = '') OR (e.is_app_root = true)) AND (e.name != ''))),
                ''
            )
        ) AS name,
        ifNull(
            anyIf(toNullable(toDate(e.start_time)), ((e.parent_span_id = '') OR (e.is_app_root = true))),
            min(toDate(e.start_time))
        ) AS time_dimension,
        uniq(e.trace_id) AS count
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND ((e.trace_id IN (
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        )) OR (NOT exists((
            SELECT e.trace_id
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND ((e.parent_span_id = '') OR (e.is_app_root = true))
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            LIMIT 1
        ))))
    GROUP BY
        e.project_id,
        e.trace_id
) AS per_trace
GROUP BY
    name,
    time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param2:DateTime64(3, 'UTC')}) TO toDate({param3:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;


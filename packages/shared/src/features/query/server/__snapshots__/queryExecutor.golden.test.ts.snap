exports[`golden: metrics v2 executeQuery > scores-categorical > group by tags 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-02 00:00:00.000",
      "param4": "CATEGORICAL",
    },
    "route": "unknown",
    "sql": "SELECT
    tags AS tags,
    count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores.id,
        any(events_traces.tags) AS tags,
        count(1) AS count
    FROM scores
    FINAL
    INNER JOIN
    (
        SELECT *
        FROM
        (
            SELECT
                e.trace_id AS id,
                e.project_id AS project_id,
                arraySort(groupUniqArrayArrayIf(e.tags, notEmpty(e.tags))) AS tags
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            GROUP BY
                e.trace_id,
                e.project_id
        ) AS events_traces_all
        WHERE events_traces_all.id IN (
            SELECT scores.trace_id
            FROM scores
            WHERE (scores.project_id = {param1:String})
                AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
                AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
                AND (scores.data_type = {param4:String})
        )
    ) AS events_traces ON (scores.trace_id = events_traces.id) AND (scores.project_id = events_traces.project_id)
    WHERE (scores.project_id = {param1:String})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
        AND (scores.data_type = {param4:String})
    GROUP BY
        scores.project_id,
        scores.id
) AS per_score
GROUP BY tags
ORDER BY count_count DESC",
  },
]
`;


exports[`golden: metrics v2 executeQuery > scores-categorical > filter traceName 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-02 00:00:00.000",
      "param4": "CATEGORICAL",
      "param5": "golden-trace-name",
    },
    "route": "unknown",
    "sql": "SELECT count(1) AS count_count
FROM scores
FINAL
WHERE (scores.project_id = {param1:String})
    AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
    AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
    AND (scores.data_type = {param4:String})
    AND (scores.trace_id IN (
        SELECT events_traces.id
        FROM
        (
            SELECT
                e.trace_id AS id,
                e.project_id AS project_id,
                coalesce(
                    nullIf(argMaxIf(e.trace_name, e.event_ts, e.trace_name != ''), ''),
                    nullIf(
                        argMaxIf(
                            e.name,
                            e.event_ts,
                            (((e.parent_span_id = '') OR (e.is_app_root = true)) AND (e.name != ''))
                        ),
                        ''
                    )
                ) AS name
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            GROUP BY
                e.trace_id,
                e.project_id
        ) AS events_traces
        WHERE (events_traces.name = {param5:String})
            AND (events_traces.id IN (
                SELECT scores.trace_id
                FROM scores
                WHERE (scores.project_id = {param1:String})
                    AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
                    AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
                    AND (scores.data_type = {param4:String})
            ))
    ))
ORDER BY count_count DESC",
  },
]
`;


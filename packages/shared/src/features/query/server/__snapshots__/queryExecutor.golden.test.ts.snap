exports[`golden: metrics v2 executeQuery > scores-categorical > group by traceName 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-02 00:00:00.000",
      "param4": "CATEGORICAL",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-02 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    traceName AS traceName,
    count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores_categorical.id,
        any(
            COALESCE(
                nullIf(events_traces.trace_name, ''),
                if(
                    ((events_traces.parent_span_id = '') OR (events_traces.is_app_root = true)),
                    nullIf(events_traces.name, ''),
                    NULL
                )
            )
        ) AS traceName,
        count(1) AS count
    FROM scores AS scores_categorical
    FINAL
    INNER JOIN events_core AS events_traces ON (scores.trace_id = events_traces.trace_id) AND (scores.project_id = events_traces.project_id) AND (events_traces.parent_span_id = '')
    WHERE (scores.project_id = {param1:String})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
        AND (scores_categorical.data_type = {param4:String})
        AND (events_traces.start_time >= {param5:DateTime64(3, 'UTC')})
        AND (events_traces.start_time <= {param6:DateTime64(3, 'UTC')})
    GROUP BY
        scores.project_id,
        scores_categorical.id
)
GROUP BY traceName
ORDER BY count_count DESC",
  },
]
`;


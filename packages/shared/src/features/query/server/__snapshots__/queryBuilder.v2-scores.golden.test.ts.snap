exports[`golden: executeQuery v2 scores > dimensions > build join=events_observations dims=all-observation 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": [
        "NUMERIC",
        "BOOLEAN",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    observationName AS observationName,
    observationModelName AS observationModelName,
    observationPromptName AS observationPromptName,
    observationPromptVersion AS observationPromptVersion,
    experimentName AS experimentName,
    experimentId AS experimentId,
    count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores.id,
        any(e.name) AS observationName,
        any(nullIf(e.provided_model_name, '')) AS observationModelName,
        any(nullIf(e.prompt_name, '')) AS observationPromptName,
        any(e.prompt_version) AS observationPromptVersion,
        any(nullIf(e.experiment_name, '')) AS experimentName,
        any(nullIf(e.experiment_id, '')) AS experimentId,
        count(1) AS count
    FROM scores
    FINAL
    INNER JOIN events_core AS e ON (scores.project_id = e.project_id) AND (scores.trace_id = e.trace_id) AND (scores.observation_id = e.span_id) AND (e.project_id = {param1:String})
    WHERE (scores.project_id = {param1:String})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
        AND (scores.data_type IN ({param4:Array(String)}))
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        scores.project_id,
        scores.id
) AS per_score
GROUP BY
    observationName,
    observationModelName,
    observationPromptName,
    observationPromptVersion,
    experimentName,
    experimentId
ORDER BY count_count DESC",
  },
]
`;

exports[`golden: executeQuery v2 scores > dimensions > build join=events_traces dims=traceName,userId,tags,traceRelease,traceVersion 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": [
        "NUMERIC",
        "BOOLEAN",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    traceName AS traceName,
    userId AS userId,
    tags AS tags,
    traceRelease AS traceRelease,
    traceVersion AS traceVersion,
    count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores.id,
        any(events_traces.name) AS traceName,
        any(nullIf(events_traces.user_id, '')) AS userId,
        any(events_traces.tags) AS tags,
        any(nullIf(events_traces.release, '')) AS traceRelease,
        any(nullIf(events_traces.version, '')) AS traceVersion,
        count(1) AS count
    FROM scores
    FINAL
    INNER JOIN
    (
        SELECT *
        FROM
        (
            SELECT
                e.trace_id AS id,
                e.project_id AS project_id,
                coalesce(
                    nullIf(argMaxIf(e.trace_name, e.event_ts, e.trace_name != ''), ''),
                    nullIf(
                        argMaxIf(
                            e.name,
                            e.event_ts,
                            (((e.parent_span_id = '') OR (e.is_app_root = true)) AND (e.name != ''))
                        ),
                        ''
                    )
                ) AS name,
                argMaxIf(e.user_id, e.event_ts, e.user_id != '') AS user_id,
                argMaxIf(e.release, e.event_ts, e.release != '') AS release,
                argMaxIf(e.version, e.event_ts, e.version != '') AS version,
                arraySort(groupUniqArrayArrayIf(e.tags, notEmpty(e.tags))) AS tags
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            GROUP BY
                e.trace_id,
                e.project_id
        ) AS events_traces_all
        WHERE events_traces_all.id IN (
            SELECT scores.trace_id
            FROM scores
            WHERE (scores.project_id = {param1:String})
                AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
                AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
                AND (scores.data_type IN ({param4:Array(String)}))
        )
    ) AS events_traces ON (scores.trace_id = events_traces.id) AND (scores.project_id = events_traces.project_id)
    WHERE (scores.project_id = {param1:String})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
        AND (scores.data_type IN ({param4:Array(String)}))
    GROUP BY
        scores.project_id,
        scores.id
) AS per_score
GROUP BY
    traceName,
    userId,
    tags,
    traceRelease,
    traceVersion
ORDER BY count_count DESC",
  },
]
`;

exports[`golden: executeQuery v2 scores > dimensions > build level=single dims=all-score-specific 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": [
        "NUMERIC",
        "BOOLEAN",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    scores.id AS id,
    scores.environment AS environment,
    scores.name AS name,
    scores.evaluator_id AS evaluatorId,
    scores.evaluation_rule_id AS ruleId,
    toBool((scores.metadata['evaluator_test']) = 'true') AS isEvaluatorTest,
    scores.source AS source,
    scores.data_type AS dataType,
    scores.trace_id AS traceId,
    scores.config_id AS configId,
    formatDateTime(scores.timestamp, '%Y-%m') AS timestampMonth,
    formatDateTime(scores.timestamp, '%Y-%m-%d') AS timestampDay,
    scores.observation_id AS observationId,
    scores.session_id AS sessionId,
    nullIf(scores.dataset_run_id, '') AS datasetRunId,
    scores.value AS value,
    count(1) AS count_count
FROM scores
FINAL
WHERE (scores.project_id = {param1:String})
    AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
    AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
    AND (scores.data_type IN ({param4:Array(String)}))
GROUP BY
    id,
    environment,
    name,
    evaluatorId,
    ruleId,
    isEvaluatorTest,
    source,
    dataType,
    traceId,
    configId,
    timestampMonth,
    timestampDay,
    observationId,
    sessionId,
    datasetRunId,
    value
ORDER BY count_count DESC",
  },
]
`;


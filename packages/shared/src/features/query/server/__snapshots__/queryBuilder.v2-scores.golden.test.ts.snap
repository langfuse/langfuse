exports[`golden: executeQuery v2 scores > joins > build join=events_observations,events_traces dims=observationName,traceName 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param10": "2026-01-08 00:00:00.000",
      "param11": [
        "NUMERIC",
        "BOOLEAN",
      ],
      "param12": "2026-01-01 00:00:00.000",
      "param13": "2026-01-08 00:00:00.000",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": "golden-project",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-08 00:00:00.000",
      "param7": [
        "NUMERIC",
        "BOOLEAN",
      ],
      "param8": "golden-project",
      "param9": "2026-01-01 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    observationName AS observationName,
    traceName AS traceName,
    count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores_numeric.id,
        any(events_observations.name) AS observationName,
        any(events_traces.name) AS traceName,
        count(1) AS count
    FROM scores AS scores_numeric
    FINAL
    INNER JOIN events_core AS events_observations ON (scores.project_id = events_observations.project_id) AND (scores.trace_id = events_observations.trace_id) AND (scores.observation_id = events_observations.span_id)
    INNER JOIN
    (
        SELECT *
        FROM
        (
            SELECT
                e.trace_id AS id,
                e.project_id AS project_id,
                coalesce(
                    nullIf(argMaxIf(e.trace_name, e.event_ts, e.trace_name != ''), ''),
                    nullIf(
                        argMaxIf(
                            e.name,
                            e.event_ts,
                            (((e.parent_span_id = '') OR (e.is_app_root = true)) AND (e.name != ''))
                        ),
                        ''
                    )
                ) AS name
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            GROUP BY
                e.trace_id,
                e.project_id
        ) AS events_traces_all
        WHERE events_traces_all.id IN (
            SELECT scores.trace_id
            FROM scores AS scores_numeric
            WHERE (scores.project_id = {param4:String})
                AND (scores.timestamp >= {param5:DateTime64(3, 'UTC')})
                AND (scores.timestamp <= {param6:DateTime64(3, 'UTC')})
                AND (scores_numeric.data_type IN ({param7:Array(String)}))
        )
    ) AS events_traces ON (scores.trace_id = events_traces.id) AND (scores.project_id = events_traces.project_id)
    WHERE (scores.project_id = {param8:String})
        AND (scores.timestamp >= {param9:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param10:DateTime64(3, 'UTC')})
        AND (scores_numeric.data_type IN ({param11:Array(String)}))
        AND (events_observations.start_time >= {param12:DateTime64(3, 'UTC')})
        AND (events_observations.start_time <= {param13:DateTime64(3, 'UTC')})
    GROUP BY
        scores.project_id,
        scores_numeric.id
)
GROUP BY
    observationName,
    traceName
ORDER BY count_count DESC",
  },
]
`;


exports[`golden: executeQuery v2 scores > bucketing > build bucket=entity field=experimentId 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": [
        "NUMERIC",
        "BOOLEAN",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    entity_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores.id,
        any(nullIf(e.experiment_id, '')) AS entity_dimension,
        count(1) AS count
    FROM scores
    FINAL
    INNER JOIN events_core AS e ON (scores.project_id = e.project_id) AND (scores.trace_id = e.trace_id) AND (scores.observation_id = e.span_id) AND (e.project_id = {param1:String})
    WHERE (scores.project_id = {param1:String})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
        AND (scores.data_type IN ({param4:Array(String)}))
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        scores.project_id,
        scores.id
) AS per_score
GROUP BY entity_dimension
ORDER BY count_count DESC",
  },
]
`;


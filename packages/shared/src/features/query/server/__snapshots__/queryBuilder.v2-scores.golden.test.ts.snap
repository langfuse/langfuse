exports[`golden: executeQuery v2 scores > bucketing > build bucket=time,entity throws 1`] = `[InvalidRequestError: Invalid query: [{"code":"custom","path":[],"message":"timeDimension and entityDimension are mutually exclusive"}]]`;

exports[`golden: executeQuery v2 scores > bucketing > build level=two bucket=time 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": [
        "NUMERIC",
        "BOOLEAN",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    traceName AS traceName,
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores.id,
        any(events_traces.name) AS traceName,
        any(toStartOfHour(scores.timestamp)) AS time_dimension,
        count(1) AS count
    FROM scores
    FINAL
    INNER JOIN
    (
        SELECT *
        FROM
        (
            SELECT
                e.trace_id AS id,
                e.project_id AS project_id,
                coalesce(
                    nullIf(argMaxIf(e.trace_name, e.event_ts, e.trace_name != ''), ''),
                    nullIf(
                        argMaxIf(
                            e.name,
                            e.event_ts,
                            (((e.parent_span_id = '') OR (e.is_app_root = true)) AND (e.name != ''))
                        ),
                        ''
                    )
                ) AS name
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
                AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
            GROUP BY
                e.trace_id,
                e.project_id
        ) AS events_traces_all
        WHERE events_traces_all.id IN (
            SELECT scores.trace_id
            FROM scores
            WHERE (scores.project_id = {param1:String})
                AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
                AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
                AND (scores.data_type IN ({param4:Array(String)}))
        )
    ) AS events_traces ON (scores.trace_id = events_traces.id) AND (scores.project_id = events_traces.project_id)
    WHERE (scores.project_id = {param1:String})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
        AND (scores.data_type IN ({param4:Array(String)}))
    GROUP BY
        scores.project_id,
        scores.id
) AS per_score
GROUP BY
    traceName,
    time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toStartOfHour({param2:DateTime64(3, 'UTC')}) TO toStartOfHour({param3:DateTime64(3, 'UTC')}) STEP toIntervalHour(1)",
  },
]
`;

exports[`golden: executeQuery v2 scores > dimensions > build dims=name,source,dataType metrics=count,value 1`] = `

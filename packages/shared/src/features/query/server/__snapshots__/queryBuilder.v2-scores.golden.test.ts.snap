exports[`golden: executeQuery v2 scores > filters > build semi-join filter=arrayOptions tags all-of 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": [
        "NUMERIC",
        "BOOLEAN",
      ],
      "param5": [
        "a",
        "b",
      ],
    },

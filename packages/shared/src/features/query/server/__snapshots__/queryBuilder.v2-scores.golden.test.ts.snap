    "sql": "SELECT
    observationName AS observationName,
    observationModelName AS observationModelName,
    observationPromptName AS observationPromptName,
    observationPromptVersion AS observationPromptVersion,
    experimentName AS experimentName,
    experimentId AS experimentId,
    count(count) AS count_count
FROM
(
    SELECT
        scores.project_id,
        scores_numeric.id,
        any(events_observations.name) AS observationName,
        any(nullIf(events_observations.provided_model_name, '')) AS observationModelName,
        any(nullIf(events_observations.prompt_name, '')) AS observationPromptName,
        any(events_observations.prompt_version) AS observationPromptVersion,
        any(nullIf(events_observations.experiment_name, '')) AS experimentName,
        any(nullIf(events_observations.experiment_id, '')) AS experimentId,
        count(1) AS count
    FROM scores AS scores_numeric
    FINAL
    INNER JOIN events_core AS events_observations ON (scores.project_id = events_observations.project_id) AND (scores.trace_id = events_observations.trace_id) AND (scores.observation_id = events_observations.span_id)
    WHERE (scores.project_id = {param1:String})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
        AND (scores_numeric.data_type IN ({param4:Array(String)}))
        AND (events_observations.start_time >= {param5:DateTime64(3, 'UTC')})
        AND (events_observations.start_time <= {param6:DateTime64(3, 'UTC')})
    GROUP BY
        scores.project_id,
        scores_numeric.id
)
GROUP BY
    observationName,
    observationModelName,
    observationPromptName,
    observationPromptVersion,
    experimentName,
    experimentId
ORDER BY count_count DESC",
  },
]
`;


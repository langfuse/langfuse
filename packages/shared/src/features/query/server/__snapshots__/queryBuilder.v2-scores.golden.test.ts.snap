exports[`golden: executeQuery v2 scores > other clauses > build level=two bucket=time row_limit via chartConfig 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",

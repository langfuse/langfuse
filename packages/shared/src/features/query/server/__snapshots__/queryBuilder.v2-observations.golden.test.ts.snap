exports[`golden: executeQuery v2 observations > bucketing > build bucket=time granularity=5m 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": "2026-01-01 00:00:00.000",
      "param5": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    toStartOfInterval(events_core.start_time, toIntervalMinute(5)) AS time_dimension,
    count((1)) AS count_count
FROM events_core AS events_observations
WHERE (events_core.project_id = {param1:String})
    AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toStartOfInterval({param4:DateTime64(3, 'UTC')}, toIntervalMinute(5)) TO toStartOfInterval({param5:DateTime64(3, 'UTC')}, toIntervalMinute(5)) STEP toIntervalMinute(5)",
  },
]
`;


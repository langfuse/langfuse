exports[`golden: executeQuery v2 observations > measures > build measure=countScores skipScoresFinal=true 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": "2026-01-01 00:00:00.000",
      "param5": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT sum(countScores) AS sum_countScores
FROM
(
    SELECT
        events_core.project_id,
        events_observations.span_id,
        uniq(scores.id) AS countScores
    FROM events_core AS events_observations
    INNER JOIN scores ON (events_observations.span_id = scores.observation_id) AND (events_observations.project_id = scores.project_id)
    WHERE (events_core.project_id = {param1:String})
        AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
        AND (scores.timestamp >= {param4:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param5:DateTime64(3, 'UTC')})
    GROUP BY
        events_core.project_id,
        events_observations.span_id
)
ORDER BY sum_countScores DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > measures > build metrics=count,totalCost,latency 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    count((1)) AS count_count,
    sum((toNullable(total_cost))) AS sum_totalCost,
    quantile(
        0.95
    )(dateDiff('millisecond', (events_observations.start_time), (events_observations.end_time))) AS p95_latency
FROM events_core AS events_observations
WHERE (events_core.project_id = {param1:String})
    AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
ORDER BY count_count DESC",
  },
]
`;


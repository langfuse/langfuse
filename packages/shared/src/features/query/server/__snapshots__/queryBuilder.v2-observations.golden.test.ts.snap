exports[`golden: executeQuery v2 observations > measures > build level=two measure=inputTokens agg=sum 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT sum(inputTokens) AS sum_inputTokens
FROM
(
    SELECT
        events_core.project_id,
        events_observations.span_id,
        arraySum(
            mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), any(usage_details)))
        ) AS inputTokens
    FROM events_core AS events_observations
    WHERE (events_core.project_id = {param1:String})
        AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        events_core.project_id,
        events_observations.span_id
)
ORDER BY sum_inputTokens DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > measures > build level=two measure=latency agg=avg 1`] = `

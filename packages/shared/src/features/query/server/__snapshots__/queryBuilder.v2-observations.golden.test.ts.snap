exports[`golden: executeQuery v2 observations > dimensions > build level=single dims=name,environment metrics=count,latency 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    e.name AS name,
    nullIf(e.environment, '') AS environment,
    count(1) AS count_count,
    avg(dateDiff('millisecond', e.start_time, e.end_time)) AS avg_latency
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
GROUP BY
    name,
    environment
ORDER BY count_count DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > dimensions > build level=two dims=name,environment metrics=count,latency 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    name AS name,
    environment AS environment,
    count(count) AS count_count,
    avg(latency) AS avg_latency
FROM
(
    SELECT
        e.project_id,
        e.span_id,
        any(e.name) AS name,
        any(nullIf(e.environment, '')) AS environment,
        count(1) AS count,
        dateDiff('millisecond', any(e.start_time), any(e.end_time)) AS latency
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        e.project_id,
        e.span_id
) AS per_span
GROUP BY
    name,
    environment
ORDER BY count_count DESC",
  },
]
`;


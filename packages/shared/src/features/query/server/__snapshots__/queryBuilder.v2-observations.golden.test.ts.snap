exports[`golden: executeQuery v2 observations > crosses > build bucket=time filter=metadata-full 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "region",
      "param3": "%eu%",
      "param4": "eu",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    toDate(e.start_time) AS time_dimension,
    count(1) AS count_count
FROM events_full AS e
WHERE (e.project_id = {param1:String})
    AND has(e.metadata_names, {param2:String})
    AND like(arrayStringConcat(e.metadata_values), {param3:String})
    AND (position(e.metadata_values[indexOf(e.metadata_names, {param2:String})], {param4:String}) > 0)
    AND (e.start_time >= {param5:DateTime64(3, 'UTC')})
    AND (e.start_time <= {param6:DateTime64(3, 'UTC')})
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param5:DateTime64(3, 'UTC')}) TO toDate({param6:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;

exports[`golden: executeQuery v2 observations > crosses > build dim=aiGatewayKeyOwnerUserId filter=aiGatewayKeyOwnerUserId is not null 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    if(
        e.service_name = 'langfuse-ai-gateway',
        nullIf(e.metadata_values[indexOf(e.metadata_names, 'langfuse.gateway.api_key.owner.user_id')], ''),
        NULL
    ) AS aiGatewayKeyOwnerUserId,
    count(1) AS count_count
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (if(e.service_name = 'langfuse-ai-gateway', nullIf(e.metadata_values[indexOf(e.metadata_names, 'langfuse.gateway.api_key.owner.user_id')], ''), NULL) IS NOT NULL)
    AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
GROUP BY aiGatewayKeyOwnerUserId
ORDER BY count_count DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > crosses > build dim=aiGatewayKeyOwnerUserId filter=metadata-full 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "region",
      "param3": "%eu%",
      "param4": "eu",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    if(
        e.service_name = 'langfuse-ai-gateway',
        nullIf(
            arrayMap(
                v -> leftUTF8(v, 200),
                e.metadata_values
            )[indexOf(e.metadata_names, 'langfuse.gateway.api_key.owner.user_id')],
            ''
        ),
        NULL
    ) AS aiGatewayKeyOwnerUserId,
    count(1) AS count_count
FROM events_full AS e
WHERE (e.project_id = {param1:String})
    AND has(e.metadata_names, {param2:String})
    AND like(arrayStringConcat(e.metadata_values), {param3:String})
    AND (position(e.metadata_values[indexOf(e.metadata_names, {param2:String})], {param4:String}) > 0)
    AND (e.start_time >= {param5:DateTime64(3, 'UTC')})
    AND (e.start_time <= {param6:DateTime64(3, 'UTC')})
GROUP BY aiGatewayKeyOwnerUserId
ORDER BY count_count DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > crosses > build level=two bucket=time filter=metadata-full 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "region",
      "param3": "%eu%",
      "param4": "eu",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        e.project_id,
        e.span_id,
        any(toDate(e.start_time)) AS time_dimension,
        count(1) AS count
    FROM events_full AS e
    WHERE (e.project_id = {param1:String})
        AND has(e.metadata_names, {param2:String})
        AND like(arrayStringConcat(e.metadata_values), {param3:String})
        AND (position(e.metadata_values[indexOf(e.metadata_names, {param2:String})], {param4:String}) > 0)
        AND (e.start_time >= {param5:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param6:DateTime64(3, 'UTC')})
    GROUP BY
        e.project_id,
        e.span_id
) AS per_span
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param5:DateTime64(3, 'UTC')}) TO toDate({param6:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;

exports[`golden: executeQuery v2 observations > crosses > build measures=countScores,costByType 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    costType,
    sum(countScores) AS sum_countScores,
    sum(costByType) AS sum_costByType
FROM
(
    SELECT
        e.project_id,
        e.span_id,
        costType,
        uniq(scores.id) AS countScores,
        any(cost_value) AS costByType
    FROM events_core AS e
    INNER JOIN scores
    FINAL ON (
        (e.span_id = scores.observation_id) AND (e.project_id = scores.project_id)
    ) AND (scores.project_id = {param1:String})
    ARRAY JOIN
        mapKeys(e.cost_details) AS costType,
        mapValues(e.cost_details) AS cost_value
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        e.project_id,
        e.span_id,
        costType
) AS per_span
GROUP BY costType
ORDER BY sum_countScores DESC",
  },
]
`;


exports[`golden: executeQuery v2 observations > aggregations > build level=two agg=histogram 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT histogram(25)(toFloat64(latency)) AS histogram_latency
FROM
(
    SELECT
        e.project_id,
        e.span_id,
        dateDiff('millisecond', any(e.start_time), any(e.end_time)) AS latency
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        e.project_id,
        e.span_id
) AS per_span
ORDER BY histogram_latency DESC",
  },
]
`;


exports[`golden: executeQuery v2 observations > bucketing > build bucket=time granularity=1d 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    toStartOfInterval(e.start_time, toIntervalDay(1)) AS time_dimension,
    count(1) AS count_count
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toStartOfInterval({param2:DateTime64(3, 'UTC')}, toIntervalDay(1)) TO toStartOfInterval({param3:DateTime64(3, 'UTC')}, toIntervalDay(1)) STEP toIntervalDay(1)",
  },
]
`;


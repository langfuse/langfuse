exports[`golden: executeQuery v2 observations > measures > build measure=countScores skipScoresFinal=true 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT sum(countScores) AS sum_countScores
FROM
(
    SELECT
        e.project_id,
        e.span_id,
        uniq(scores.id) AS countScores
    FROM events_core AS e
    INNER JOIN scores ON ((e.span_id = scores.observation_id) AND (e.project_id = scores.project_id) AND (scores.is_deleted = 0)) AND (scores.project_id = {param1:String})
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
        AND (scores.timestamp >= {param2:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        e.project_id,
        e.span_id
) AS per_span
ORDER BY sum_countScores DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > measures > build metrics=count,totalCost,latency 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    count(1) AS count_count,
    sum(toNullable(e.total_cost)) AS sum_totalCost,
    quantile(0.95)(dateDiff('millisecond', e.start_time, e.end_time)) AS p95_latency
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
ORDER BY count_count DESC",
  },
]
`;


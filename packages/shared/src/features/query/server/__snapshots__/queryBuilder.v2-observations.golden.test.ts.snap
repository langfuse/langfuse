exports[`golden: executeQuery v2 observations > crosses > build bucket=time dim=explodeArray 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": "2026-01-01 00:00:00.000",
      "param5": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    arrayJoin(mapKeys(events_observations.tool_definitions)) AS toolNames,
    toDate(events_core.start_time) AS time_dimension,
    count((1)) AS count_count
FROM events_core AS events_observations
WHERE (events_core.project_id = {param1:String})
    AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
GROUP BY
    toolNames,
    time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param4:DateTime64(3, 'UTC')}) TO toDate({param5:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;

exports[`golden: executeQuery v2 observations > crosses > build bucket=time filter=metadata-full 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "region",
      "param2": "%eu%",
      "param3": "eu",
      "param4": "golden-project",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-08 00:00:00.000",
      "param7": "2026-01-01 00:00:00.000",
      "param8": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    toDate(events_full.start_time) AS time_dimension,
    count((1)) AS count_count
FROM events_full AS events_observations
WHERE has(events_full.metadata_names, {param1:String})
    AND like(arrayStringConcat(events_full.metadata_values), {param2:String})
    AND (position(events_full.metadata_values[indexOf(events_full.metadata_names, {param1:String})], {param3:String}) > 0)
    AND (events_full.project_id = {param4:String})
    AND (events_full.start_time >= {param5:DateTime64(3, 'UTC')})
    AND (events_full.start_time <= {param6:DateTime64(3, 'UTC')})
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param7:DateTime64(3, 'UTC')}) TO toDate({param8:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;

exports[`golden: executeQuery v2 observations > crosses > build level=two bucket=time filter=metadata-full 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "region",
      "param2": "%eu%",
      "param3": "eu",
      "param4": "golden-project",
      "param5": "2026-01-01 00:00:00.000",
      "param6": "2026-01-08 00:00:00.000",
      "param7": "2026-01-01 00:00:00.000",
      "param8": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        events_full.project_id,
        events_observations.span_id,
        any(toDate(events_full.start_time)) AS time_dimension,
        count(1) AS count
    FROM events_full AS events_observations
    WHERE has(events_full.metadata_names, {param1:String})
        AND like(arrayStringConcat(events_full.metadata_values), {param2:String})
        AND (position(events_full.metadata_values[indexOf(events_full.metadata_names, {param1:String})], {param3:String}) > 0)
        AND (events_full.project_id = {param4:String})
        AND (events_full.start_time >= {param5:DateTime64(3, 'UTC')})
        AND (events_full.start_time <= {param6:DateTime64(3, 'UTC')})
    GROUP BY
        events_full.project_id,
        events_observations.span_id
)
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param7:DateTime64(3, 'UTC')}) TO toDate({param8:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;

exports[`golden: executeQuery v2 observations > crosses > build measures=countScores,costByType 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
      "param4": "2026-01-01 00:00:00.000",
      "param5": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    costType,
    sum(countScores) AS sum_countScores,
    sum(costByType) AS sum_costByType
FROM
(
    SELECT
        events_core.project_id,
        events_observations.span_id,
        costType,
        uniq(scores.id) AS countScores,
        any(cost_value) AS costByType
    FROM events_core AS events_observations
    INNER JOIN scores
    FINAL ON (
        events_observations.span_id = scores.observation_id
    ) AND (events_observations.project_id = scores.project_id)
    ARRAY JOIN
        mapKeys(events_observations.cost_details) AS costType,
        mapValues(events_observations.cost_details) AS cost_value
    WHERE (events_core.project_id = {param1:String})
        AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
        AND (scores.timestamp >= {param4:DateTime64(3, 'UTC')})
        AND (scores.timestamp <= {param5:DateTime64(3, 'UTC')})
    GROUP BY
        events_core.project_id,
        events_observations.span_id,
        costType
)
GROUP BY costType
ORDER BY sum_countScores DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > dimensions > build dims=costType,usageType throws 1`] = `[InvalidRequestError: Only one pairExpand dimension is supported per query. Found: costType, usageType]`;

exports[`golden: executeQuery v2 observations > dimensions > build level=single dim=aiGatewayKeyOwnerUserId 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    if(
        events_observations.service_name = 'langfuse-ai-gateway',
        nullIf(
            events_observations.metadata_values[
                indexOf(events_observations.metadata_names, 'langfuse.gateway.api_key.owner.user_id')
            ],
            ''
        ),
        NULL
    ) AS aiGatewayKeyOwnerUserId,
    count((1)) AS count_count
FROM events_core AS events_observations
WHERE (events_core.project_id = {param1:String})
    AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
GROUP BY aiGatewayKeyOwnerUserId
ORDER BY count_count DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > dimensions > build level=single dims=name,environment metrics=count,latency 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    events_observations.name AS name,
    nullIf(events_observations.environment, '') AS environment,
    count((1)) AS count_count,
    avg(dateDiff('millisecond', (events_observations.start_time), (events_observations.end_time))) AS avg_latency
FROM events_core AS events_observations
WHERE (events_core.project_id = {param1:String})
    AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
    AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
GROUP BY
    name,
    environment
ORDER BY count_count DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > dimensions > build level=two dims=name,environment metrics=count,latency 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    name AS name,
    environment AS environment,
    count(count) AS count_count,
    avg(latency) AS avg_latency
FROM
(
    SELECT
        events_core.project_id,
        events_observations.span_id,
        any(events_observations.name) AS name,
        any(nullIf(events_observations.environment, '')) AS environment,
        count(1) AS count,
        dateDiff('millisecond', any(events_observations.start_time), any(events_observations.end_time)) AS latency
    FROM events_core AS events_observations
    WHERE (events_core.project_id = {param1:String})
        AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        events_core.project_id,
        events_observations.span_id
)
GROUP BY
    name,
    environment
ORDER BY count_count DESC",
  },
]
`;


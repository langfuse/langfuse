]
`;

exports[`golden: executeQuery v2 observations > measures > build level=two measure=tokensPerSecond agg=avg 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT avg(tokensPerSecond) AS avg_tokensPerSecond
FROM
(
    SELECT
        events_core.project_id,
        events_observations.span_id,
        (
            sumMap(usage_details)['total']
        ) / nullIf(dateDiff('second', any(events_observations.start_time), any(events_observations.end_time)), 0) AS tokensPerSecond
    FROM events_core AS events_observations
    WHERE (events_core.project_id = {param1:String})
        AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        events_core.project_id,
        events_observations.span_id
)
ORDER BY avg_tokensPerSecond DESC",
  },
]
`;

exports[`golden: executeQuery v2 observations > measures > build level=two measure=toolCallInvocations agg=sum 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    calledToolNames AS calledToolNames,
    sum(toolCallInvocations) AS sum_toolCallInvocations
FROM
(
    SELECT
        events_core.project_id,
        events_observations.span_id,
        arrayJoin(arrayDistinct(events_observations.tool_call_names)) AS calledToolNames,
        countEqual(any(events_observations.tool_call_names), calledToolNames) AS toolCallInvocations
    FROM events_core AS events_observations
    WHERE (events_core.project_id = {param1:String})
        AND (events_core.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (events_core.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        events_core.project_id,
        events_observations.span_id,
        calledToolNames
)
GROUP BY calledToolNames
ORDER BY sum_toolCallInvocations DESC",
  },
]
`;


        e.project_id,
        e.span_id,
        (
            sumMap(e.usage_details)['total']
        ) / nullIf(dateDiff('second', any(e.start_time), any(e.end_time)), 0) AS tokensPerSecond
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        e.project_id,
        e.span_id
) AS per_span
ORDER BY avg_tokensPerSecond DESC",

exports[`golden: executeQuery v2 observations > levels > build level=two bucket=time 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
      "param3": "2026-01-08 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    time_dimension,
    count(count) AS count_count
FROM
(
    SELECT
        e.project_id,
        e.span_id,
        any(toDate(e.start_time)) AS time_dimension,
        count(1) AS count
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.start_time >= {param2:DateTime64(3, 'UTC')})
        AND (e.start_time <= {param3:DateTime64(3, 'UTC')})
    GROUP BY
        e.project_id,
        e.span_id
) AS per_span
GROUP BY time_dimension
ORDER BY time_dimension ASC WITH FILL FROM toDate({param2:DateTime64(3, 'UTC')}) TO toDate({param3:DateTime64(3, 'UTC')}) STEP toIntervalDay(1)",
  },
]
`;


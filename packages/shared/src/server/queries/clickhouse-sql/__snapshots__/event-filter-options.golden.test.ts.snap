      "param5": [
        "GENERATION",
      ],
      "param6": "quality",
      "param7": 0.5,
      "param8": "quality",
      "param9": 0.5,
    },
    "route": "unknown",
    "sql": "WITH
    aggregated_options AS
    (
        WITH
            scores_agg AS
            (
                SELECT
                    trace_id,
                    observation_id,
                    groupArrayIf(
                        tuple(name, avg_value, data_type, string_value),
                        (data_type IN ('NUMERIC', 'BOOLEAN'))
                    ) AS scores_avg,
                    groupArrayIf(
                        concat(name, ':', string_value),
                        (data_type IN ('CATEGORICAL', 'TEXT')) AND notEmpty(string_value)
                    ) AS score_categories,
                    groupUniqArrayIf(
                        concat(name, ':', lowerUTF8(string_value)),
                        (data_type = 'BOOLEAN') AND notEmpty(string_value)
                    ) AS score_booleans
                FROM
                (
                    SELECT
                        observation_id,
                        trace_id,
                        comment,
                        name,
                        data_type,
                        string_value,
                        avg(value) AS avg_value
                    FROM scores
                    FINAL
                    WHERE (project_id = {param1:String})
                        AND (name IN ({param2:Array(String)}))
                    GROUP BY
                        observation_id,
                        trace_id,
                        comment,
                        name,
                        data_type,
                        string_value
                    ORDER BY trace_id ASC
                ) AS tmp
                GROUP BY
                    observation_id,
                    trace_id
            ),
            trace_scores_agg AS
            (
                SELECT
                    trace_id,
                    project_id,
                    groupUniqArray(id) AS score_ids,
                    groupArrayIf(
                        tuple(name, avg_value, data_type, string_value),
                        (data_type IN ('NUMERIC', 'BOOLEAN'))
                    ) AS scores_avg,
                    groupArrayIf(
                        concat(name, ':', string_value),
                        (data_type IN ('CATEGORICAL', 'TEXT')) AND notEmpty(string_value)
                    ) AS score_categories,
                    groupUniqArrayIf(
                        concat(name, ':', lowerUTF8(string_value)),
                        (data_type = 'BOOLEAN') AND notEmpty(string_value)
                    ) AS score_booleans
                FROM
                (
                    SELECT
                        project_id,
                        trace_id,
                        id,
                        name,
                        data_type,
                        string_value,
                        avg(value) AS avg_value
                    FROM scores
                    FINAL
                    WHERE (project_id = {param1:String})
                        AND (observation_id IS NULL)
                        AND (name IN ({param2:Array(String)}))
                    GROUP BY
                        project_id,
                        trace_id,
                        id,
                        name,
                        data_type,
                        string_value
                ) AS tmp
                GROUP BY
                    project_id,
                    trace_id
            )
        SELECT
            sumMapIf(
                [toString(ifNull(e.user_id, ''))],
                [toUInt64(1)],
                (e.user_id IS NOT NULL) AND (length(e.user_id) > 0)
            ) AS userId_hist,
            arraySort(
                pair -> tuple(-toInt64(tupleElement(pair, 2)), tupleElement(pair, 1)),
                arrayZip(tupleElement(userId_hist, 1), tupleElement(userId_hist, 2))
            ) AS userId_ranked,
            arraySlice(userId_ranked, 1, {param3:UInt64}) AS userIdTopOptions,
            sumMapIf(
                [tuple(toString(ifNull(e.experiment_id, '')), toString(ifNull(e.experiment_name, '')))],
                [toUInt64(1)],
                (e.experiment_id IS NOT NULL) AND (length(e.experiment_id) > 0)
            ) AS experimentId_hist,
            arraySort(
                pair -> tuple(-toInt64(tupleElement(pair, 2)), tupleElement(pair, 1)),
                arrayZip(tupleElement(experimentId_hist, 1), tupleElement(experimentId_hist, 2))
            ) AS experimentId_ranked,
            arraySlice(experimentId_ranked, 1, {param3:UInt64}) AS experimentIdTopOptions,
            sumMap(
                arrayMap(
                    value -> toString(value),
                    arrayFilter(value -> (length(toString(value)) > 0), arrayDistinct(e.tags))
                ),
                arrayMap(
                    value -> toUInt64(1),
                    arrayFilter(value -> (length(toString(value)) > 0), arrayDistinct(e.tags))
                )
            ) AS traceTags_hist,
            arraySort(
                pair -> tupleElement(pair, 1),
                arrayZip(tupleElement(traceTags_hist, 1), tupleElement(traceTags_hist, 2))
            ) AS traceTags_ranked,
            arraySlice(traceTags_ranked, 1, {param3:UInt64}) AS traceTagsTopOptions,
            arrayFilter(
                option -> (tupleElement(option, 2) > 0),
                [
                    tuple('false', countIf(NOT ((e.parent_span_id = '') OR (e.is_app_root = true))), toUInt64(0)),
                    tuple('true', countIf(((e.parent_span_id = '') OR (e.is_app_root = true))), toUInt64(0))
                ]
            ) AS isRootObservationTopOptions,
            any(e._sample_factor) AS sample_factor
        FROM events_core AS e
        SAMPLE 6000000
        LEFT JOIN scores_agg AS s ON s.observation_id = e.span_id
        LEFT JOIN trace_scores_agg AS ts ON (ts.trace_id = e.trace_id) AND (ts.project_id = e.project_id)
        WHERE (e.project_id = {param1:String})
            AND ((e.project_id = {param4:String}) AND (e.type IN ({param5:Array(String)})))
            AND ((empty(arrayFilter(x -> (((x.1) = {param6:String}) AND ((x.2) > {param7:Decimal64(12)})), s.scores_avg)) = 0) OR (empty(arrayFilter(x -> (((x.1) = {param8:String}) AND ((x.2) > {param9:Decimal64(12)})), ts.scores_avg)) = 0))
    ),
    option_rows AS
    (
        SELECT
            arrayJoin(
                arrayConcat(
                    arrayMap(
                        option -> CAST(
                            tuple(
                                'userId',
                                tupleElement(option, 1),
                                tupleElement(option, 2),
                                -toInt64(tupleElement(option, 2)),
                                ''
                            ),
                            'Tuple(column String, value String, count UInt64, sortKey Int64, displayValue String)'
                        ),
                        userIdTopOptions
                    ),
                    arrayMap(
                        option -> CAST(
                            tuple(
                                'experimentId',
                                tupleElement(tupleElement(option, 1), 1),
                                tupleElement(option, 2),
                                -toInt64(tupleElement(option, 2)),
                                tupleElement(tupleElement(option, 1), 2)
                            ),
                            'Tuple(column String, value String, count UInt64, sortKey Int64, displayValue String)'
                        ),
                        experimentIdTopOptions
                    ),
                    arrayMap(
                        option -> CAST(
                            tuple('traceTags', tupleElement(option, 1), tupleElement(option, 2), toInt64(0), ''),
                            'Tuple(column String, value String, count UInt64, sortKey Int64, displayValue String)'
                        ),
                        traceTagsTopOptions
                    ),
                    arrayMap(
                        option -> CAST(
                            tuple(
                                'isRootObservation',

// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden: events filter options, filtered > getEventsFilterOptionValuesPage filter=native 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "GENERATION",
      ],
      "param3": 20,
    },
    "route": "unknown",
    "sql": "SELECT
    'userId' AS column,
    toString(e.user_id) AS value,
    count() AS count
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.type IN ({param2:Array(String)}))
    AND (e.user_id IS NOT NULL)
    AND (length(e.user_id) > 0)
GROUP BY value
ORDER BY
    count() DESC,
    value ASC
LIMIT {param3:Int32}",
  },
]
`;

exports[`golden: events filter options, filtered > getEventsFilterOptionsForColumns filter=native+obsScore 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "quality",
      ],
      "param3": 1000,
      "param4": "golden-project",
      "param5": [
        "GENERATION",
      ],
      "param6": "quality",
      "param7": 0.5,
      "param8": "quality",
      "param9": 0.5,
    },
    "route": "unknown",
    "sql": "WITH
    aggregated_options AS
    (
        WITH
            scores_agg AS
            (
                SELECT
                    trace_id,
                    observation_id,
                    groupArrayIf(
                        tuple(name, avg_value, data_type, string_value),
                        (data_type IN ('NUMERIC', 'BOOLEAN'))
                    ) AS scores_avg,
                    groupArrayIf(
                        concat(name, ':', string_value),
                        (data_type IN ('CATEGORICAL', 'TEXT')) AND notEmpty(string_value)
                    ) AS score_categories,
                    groupUniqArrayIf(
                        concat(name, ':', lowerUTF8(string_value)),
                        (data_type = 'BOOLEAN') AND notEmpty(string_value)
                    ) AS score_booleans
                FROM
                (
                    SELECT
                        observation_id,
                        trace_id,
                        comment,
                        name,
                        data_type,
                        string_value,
                        avg(value) AS avg_value
                    FROM scores
                    FINAL
                    WHERE (project_id = {param1:String})
                        AND (name IN ({param2:Array(String)}))
                    GROUP BY
                        observation_id,
                        trace_id,
                        comment,
                        name,
                        data_type,
                        string_value
                    ORDER BY trace_id ASC
                ) AS tmp
                GROUP BY
                    observation_id,
                    trace_id
            ),
            trace_scores_agg AS
            (
                SELECT
                    trace_id,
                    project_id,
                    groupUniqArray(id) AS score_ids,
                    groupArrayIf(
                        tuple(name, avg_value, data_type, string_value),
                        (data_type IN ('NUMERIC', 'BOOLEAN'))
                    ) AS scores_avg,
                    groupArrayIf(
                        concat(name, ':', string_value),
                        (data_type IN ('CATEGORICAL', 'TEXT')) AND notEmpty(string_value)
                    ) AS score_categories,
                    groupUniqArrayIf(
                        concat(name, ':', lowerUTF8(string_value)),
                        (data_type = 'BOOLEAN') AND notEmpty(string_value)
                    ) AS score_booleans
                FROM
                (
                    SELECT
                        project_id,
                        trace_id,
                        id,
                        name,
                        data_type,
                        string_value,
                        avg(value) AS avg_value
                    FROM scores
                    FINAL
                    WHERE (project_id = {param1:String})
                        AND (observation_id IS NULL)
                        AND (name IN ({param2:Array(String)}))
                    GROUP BY
                        project_id,
                        trace_id,
                        id,
                        name,
                        data_type,
                        string_value
                ) AS tmp
                GROUP BY
                    project_id,
                    trace_id
            )
        SELECT
            approx_top_kIf(
                {param3:UInt64}
            )(toString(ifNull(e.user_id, '')), (e.user_id IS NOT NULL) AND (length(e.user_id) > 0)) AS userIdTopOptions,
            approx_top_kIf(
                {param3:UInt64}
            )(tuple(toString(ifNull(e.experiment_id, '')), toString(ifNull(e.experiment_name, ''))), (e.experiment_id IS NOT NULL) AND (length(e.experiment_id) > 0)) AS experimentIdTopOptions,
            approx_top_kArray(
                {param3:UInt64}
            )(arrayMap(value -> toString(value), arrayFilter(value -> (length(toString(value)) > 0), arrayDistinct(e.tags)))) AS traceTagsTopOptions,
            arrayFilter(
                option -> (tupleElement(option, 2) > 0),
                [
                    tuple('false', countIf(NOT ((e.parent_span_id = '') OR (e.is_app_root = true))), toUInt64(0)),
                    tuple('true', countIf(((e.parent_span_id = '') OR (e.is_app_root = true))), toUInt64(0))
                ]
            ) AS isRootObservationTopOptions,
            any(e._sample_factor) AS sample_factor
        FROM events_core AS e
        SAMPLE 6000000
        LEFT JOIN scores_agg AS s ON s.observation_id = e.span_id
        LEFT JOIN trace_scores_agg AS ts ON (ts.trace_id = e.trace_id) AND (ts.project_id = e.project_id)
        WHERE (e.project_id = {param1:String})
            AND ((e.project_id = {param4:String}) AND (e.type IN ({param5:Array(String)})))
            AND ((empty(arrayFilter(x -> (((x.1) = {param6:String}) AND ((x.2) > {param7:Decimal64(12)})), s.scores_avg)) = 0) OR (empty(arrayFilter(x -> (((x.1) = {param8:String}) AND ((x.2) > {param9:Decimal64(12)})), ts.scores_avg)) = 0))
    ),
    option_rows AS
    (
        SELECT
            arrayJoin(
                arrayConcat(
                    arrayMap(
                        option -> CAST(
                            tuple(
                                'userId',
                                tupleElement(option, 1),
                                tupleElement(option, 2),
                                -toInt64(tupleElement(option, 2)),
                                ''
                            ),
                            'Tuple(column String, value String, count UInt64, sortKey Int64, displayValue String)'
                        ),
                        userIdTopOptions
                    ),
                    arrayMap(
                        option -> CAST(
                            tuple(
                                'experimentId',
                                tupleElement(tupleElement(option, 1), 1),
                                tupleElement(option, 2),
                                -toInt64(tupleElement(option, 2)),
                                tupleElement(tupleElement(option, 1), 2)
                            ),
                            'Tuple(column String, value String, count UInt64, sortKey Int64, displayValue String)'
                        ),
                        experimentIdTopOptions
                    ),
                    arrayMap(
                        option -> CAST(
                            tuple('traceTags', tupleElement(option, 1), tupleElement(option, 2), toInt64(0), ''),
                            'Tuple(column String, value String, count UInt64, sortKey Int64, displayValue String)'
                        ),
                        traceTagsTopOptions
                    ),
                    arrayMap(
                        option -> CAST(
                            tuple(
                                'isRootObservation',
                                tupleElement(option, 1),
                                tupleElement(option, 2),
                                if(tupleElement(option, 1) = 'true', toInt64(1), toInt64(0)),
                                ''
                            ),
                            'Tuple(column String, value String, count UInt64, sortKey Int64, displayValue String)'
                        ),
                        isRootObservationTopOptions
                    )
                )
            ) AS option,
            sample_factor
        FROM aggregated_options
    )
SELECT
    option.column AS column,
    option.value AS value,
    toUInt64(round(option.count * sample_factor)) AS count,
    option.displayValue AS displayValue
FROM option_rows
ORDER BY
    column ASC,
    option.sortKey ASC,
    option.value ASC",
  },
]
`;

exports[`golden: events.getEventsExactFilterOptionsForColumns > filter=native+obsScore — planner WHERE and score CTEs 1`] = `
[
  {

        WHERE (e.project_id = {param1:String})
            AND (e.session_id = {param2:String})
        GROUP BY
            trace_id,
            project_id
        ORDER BY timestamp ASC
    )
SELECT t.*
FROM session_traces AS t
WHERE (1 = 1)
    AND (t.id IN (
        SELECT e.trace_id
        FROM events_core AS e
        WHERE (e.project_id = {param3:String})
            AND ((e.project_id = {param4:String}) AND ((lower(e.name) LIKE lower({param5:String})) AND (position(e.name, {param6:String}) > 0)) AND (e.level IN ({param7:Array(String)})))
            AND (e.is_deleted = 0)
            AND (e.trace_id IN (
                SELECT e.trace_id
                FROM events_core AS e
                WHERE (e.project_id = {param8:String})
                    AND (e.session_id = {param9:String})
            ))
    ))
ORDER BY t.timestamp ASC",
  },
]
`;


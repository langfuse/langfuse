// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden: sessions simple aggregates family > getSessionTracesFromEvents 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "golden-session",
    },
    "route": "unknown",
    "sql": "SELECT
    e.trace_id AS id,
    e.project_id AS project_id,
    coalesce(
        nullIf(argMaxIf(e.trace_name, e.event_ts, e.trace_name != ''), ''),
        nullIf(argMaxIf(e.name, e.event_ts, ((e.parent_span_id = '') OR (e.is_app_root = true)) AND (e.name != '')), '')
    ) AS name,
    min(e.start_time) AS timestamp,
    argMaxIf(e.environment, e.event_ts, e.environment != '') AS environment,
    argMaxIf(e.version, e.event_ts, e.version != '') AS version,
    argMaxIf(e.session_id, e.event_ts, e.session_id != '') AS session_id,
    argMaxIf(e.user_id, e.event_ts, e.user_id != '') AS user_id,
    argMaxIf(e.input, e.event_ts, e.parent_span_id = '') AS input,
    argMaxIf(e.output, e.event_ts, e.parent_span_id = '') AS output,
    argMaxIf(
        mapFromArrays(arrayReverse(e.metadata_names), arrayReverse(e.metadata_values)),
        e.event_ts,
        e.parent_span_id = ''
    ) AS metadata,
    min(e.created_at) AS created_at,
    max(e.updated_at) AS updated_at,
    sum(e.total_cost) AS total_cost,
    if(
        max(e.end_time) IS NULL,
        NULL,
        dateDiff('millisecond', min(e.start_time), greatest(max(e.start_time), max(e.end_time)))
    ) AS latency_milliseconds,
    groupUniqArrayIf(e.span_id, e.span_id != '') AS observation_ids,
    length(
        groupUniqArrayIf(e.span_id, (e.span_id != '') AND (e.span_id != concat('t-', e.trace_id)))
    ) AS observation_count,
    argMaxIf(e.bookmarked, e.event_ts, e.parent_span_id = '') AS bookmarked,
    max(e.public) AS public,
    argMaxIf(e.experiment_item_id, e.event_ts, e.experiment_item_id != '') AS experiment_item_id,
    sumMap(e.usage_details) AS usage_details,
    sumMap(e.cost_details) AS cost_details,
    multiIf(
        arrayExists(x -> (x = 'ERROR'), groupArray(e.level)),
        'ERROR',
        arrayExists(x -> (x = 'WARNING'), groupArray(e.level)),
        'WARNING',
        arrayExists(x -> (x = 'DEFAULT'), groupArray(e.level)),
        'DEFAULT',
        'DEBUG'
    ) AS aggregated_level,
    countIf(e.level = 'WARNING') AS warning_count,
    countIf(e.level = 'ERROR') AS error_count,
    countIf(e.level = 'DEFAULT') AS default_count,
    countIf(e.level = 'DEBUG') AS debug_count,
    argMaxIf(e.tags, e.event_ts, notEmpty(e.tags)) AS tags,
    argMaxIf(e.release, e.event_ts, e.release != '') AS release,
    argMaxIf(e.evaluator_id, e.event_ts, e.evaluator_id != '') AS evaluator_id,
    argMaxIf(e.evaluation_rule_id, e.event_ts, e.evaluation_rule_id != '') AS evaluation_rule_id,
    any(e.experiment_id) AS experiment_id
FROM events_full AS e
WHERE (e.project_id = {param1:String})
    AND (e.is_deleted = 0)
    AND (e.session_id = {param2:String})
GROUP BY
    trace_id,
    project_id
ORDER BY timestamp ASC",
  },
]
`;

exports[`golden: sessions table aggregation family > getSessionsTableCountFromEvents filter=metadata+tools+sessionIds+createdAt 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param10": [
        "golden-tool",
      ],
      "param11": [
        "golden-session",
        "golden-session-b",
      ],
      "param12": "2025-12-01 00:00:00.000",
      "param2": [
        "golden-session",
        "golden-session-b",
      ],
      "param3": "2025-12-01 00:00:00.000",
      "param4": "golden-key",
      "param5": "%golden-value%",
      "param6": "golden-value",
      "param7": "golden-key",
      "param8": "%golden-value%",
      "param9": "golden-value",
    },
    "route": "unknown",
    "sql": "WITH session_data AS
    (
        SELECT
            session_id,
            max(start_time) AS max_timestamp,
            min(start_time) AS min_timestamp,
            groupUniqArray(trace_id) AS trace_ids,
            groupUniqArrayIf(user_id, (user_id IS NOT NULL) AND (user_id != '')) AS user_ids,
            uniq(trace_id) AS trace_count,
            groupUniqArrayArrayIf(tags, notEmpty(tags)) AS trace_tags,
            argMaxIf(environment, event_ts, environment != '') AS environment,
            uniqIf(span_id, parent_span_id != '') AS total_observations,
            dateDiff('second', min(start_time), max(if(isNull(end_time), start_time, end_time))) AS duration,
            sumMap(usage_details) AS session_usage_details,
            sumMap(cost_details) AS session_cost_details,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(cost_details)))
            ) AS session_input_cost,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(cost_details)))
            ) AS session_output_cost,
            sumMap(cost_details)['total'] AS session_total_cost,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(usage_details)))
            ) AS session_input_usage,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(usage_details)))
            ) AS session_output_usage,
            sumMap(usage_details)['total'] AS session_total_usage,
            argMax(metadata_names, tuple(start_time, event_ts, span_id)) AS metadata_names,
            argMax(metadata_values, tuple(start_time, event_ts, span_id)) AS metadata_values,
            groupUniqArrayArray(mapKeys(tool_definitions)) AS tool_names,
            groupUniqArrayArray(tool_call_names) AS called_tool_names,
            sum(length(tool_calls)) AS tool_calls_count
        FROM events_full AS e
        WHERE (e.project_id = {param1:String})
            AND (session_id IN ({param2:Array(String)}))
            AND (start_time >= ({param3:DateTime64(3)} - toIntervalDay(2)))
            AND (session_id IN (
                SELECT m.session_id
                FROM events_full AS m
                WHERE (m.project_id = {param1:String})
                    AND (m.start_time >= ({param3:DateTime64(3)} - toIntervalDay(2)))
                    AND (m.session_id != '')
                    AND (has(m.metadata_names, {param4:String}) AND like(arrayStringConcat(m.metadata_values), {param5:String}) AND (position(m.metadata_values[indexOf(m.metadata_names, {param4:String})], {param6:String}) > 0))
            ))
            AND (session_id != '')
        GROUP BY session_id
    )
SELECT count(s.session_id) AS count
FROM session_data AS s
WHERE has(s.metadata_names, {param7:String})
    AND like(arrayStringConcat(s.metadata_values), {param8:String})
    AND (position(s.metadata_values[indexOf(s.metadata_names, {param7:String})], {param9:String}) > 0)
    AND (hasAny({param10:Array(String)}, s.tool_names) = true)
    AND (session_id IN ({param11:Array(String)}))
    AND (min_timestamp >= {param12:DateTime64(3, 'UTC')})",
  },
]
`;

exports[`golden: sessions table aggregation family > getSessionsTableFromEvents filter=none 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": 50,
    },
    "route": "unknown",
    "sql": "WITH session_data AS
    (
        SELECT
            session_id,
            max(start_time) AS max_timestamp,
            min(start_time) AS min_timestamp,
            groupUniqArray(trace_id) AS trace_ids,
            groupUniqArrayIf(user_id, (user_id IS NOT NULL) AND (user_id != '')) AS user_ids,
            uniq(trace_id) AS trace_count,
            groupUniqArrayArrayIf(tags, notEmpty(tags)) AS trace_tags,
            argMaxIf(environment, event_ts, environment != '') AS environment,
            uniqIf(span_id, parent_span_id != '') AS total_observations,
            dateDiff('second', min(start_time), max(if(isNull(end_time), start_time, end_time))) AS duration,
            sumMap(usage_details) AS session_usage_details,
            sumMap(cost_details) AS session_cost_details,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(cost_details)))
            ) AS session_input_cost,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(cost_details)))
            ) AS session_output_cost,
            sumMap(cost_details)['total'] AS session_total_cost,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(usage_details)))
            ) AS session_input_usage,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(usage_details)))
            ) AS session_output_usage,
            sumMap(usage_details)['total'] AS session_total_usage
        FROM events_core AS e
        WHERE (e.project_id = {param1:String})
            AND (session_id != '')
        GROUP BY session_id
    )
SELECT
    s.session_id,
    s.max_timestamp,
    s.min_timestamp,
    s.trace_ids,
    s.user_ids,
    s.trace_count,
    s.trace_tags,
    s.environment,
    s.total_observations,
    s.duration,
    s.session_usage_details,
    s.session_cost_details,
    s.session_input_cost,
    s.session_output_cost,
    s.session_total_cost,
    s.session_input_usage,
    s.session_output_usage,
    s.session_total_usage
FROM session_data AS s
LIMIT {param2:Int32}",
  },
]
`;

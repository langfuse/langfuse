            argMaxIf(e.evaluation_rule_id, e.event_ts, e.evaluation_rule_id != '') AS evaluation_rule_id,
            any(e.experiment_id) AS experiment_id
        FROM events_full AS e
        WHERE (e.project_id = {param1:String})
            AND (e.session_id = {param2:String})
        GROUP BY
            trace_id,
            project_id
        ORDER BY timestamp ASC
    )
SELECT t.*
FROM session_traces AS t
WHERE (1 = 1)
    AND (t.name = {param3:String})
    AND (t.id IN (
        SELECT e.trace_id
        FROM events_core AS e
        WHERE (e.project_id = {param4:String})
            AND ((e.project_id = {param5:String}) AND ((lower(e.name) LIKE lower({param6:String})) AND (position(e.name, {param7:String}) > 0)) AND (e.level IN ({param8:Array(String)})))
            AND (e.is_deleted = 0)
            AND (e.trace_id IN (
                SELECT e.trace_id
                FROM events_core AS e
                WHERE (e.project_id = {param9:String})
                    AND (e.session_id = {param10:String})
            ))
    ))
ORDER BY t.timestamp ASC",
  },
]
`;

exports[`golden: sessions table aggregation family > getSessionsTableCountFromEvents filter=metadata+tools+sessionIds+createdAt 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param10": [
        "golden-tool",
      ],
      "param11": [
        "golden-session",
        "golden-session-b",
      ],
      "param12": "2025-12-01 00:00:00.000",
      "param2": [
        "golden-session",
        "golden-session-b",
      ],
      "param3": "2025-12-01 00:00:00.000",
      "param4": "golden-key",
      "param5": "%golden-value%",
      "param6": "golden-value",
      "param7": "golden-key",
      "param8": "%golden-value%",
      "param9": "golden-value",
    },
    "route": "unknown",
    "sql": "WITH
    session_data AS
    (
        SELECT
            e.session_id AS session_id,
            max(e.start_time) AS max_timestamp,
            min(e.start_time) AS min_timestamp,
            groupUniqArray(e.trace_id) AS trace_ids,
            groupUniqArrayIf(e.user_id, ((e.user_id IS NOT NULL) AND (e.user_id != ''))) AS user_ids,
            uniq(e.trace_id) AS trace_count,
            groupUniqArrayArrayIf(e.tags, notEmpty(e.tags)) AS trace_tags,
            argMaxIf(e.environment, e.event_ts, e.environment != '') AS environment,
            uniqIf(e.span_id, e.parent_span_id != '') AS total_observations,
            dateDiff('second', min(e.start_time), max(if(isNull(e.end_time), e.start_time, e.end_time))) AS duration,
            sumMap(e.usage_details) AS session_usage_details,
            sumMap(e.cost_details) AS session_cost_details,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(e.cost_details)))
            ) AS session_input_cost,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(e.cost_details)))
            ) AS session_output_cost,
            sumMap(e.cost_details)['total'] AS session_total_cost,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(e.usage_details)))
            ) AS session_input_usage,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(e.usage_details)))
            ) AS session_output_usage,
            sumMap(e.usage_details)['total'] AS session_total_usage,
            argMax(e.metadata_names, tuple(e.start_time, e.event_ts, e.span_id)) AS metadata_names,
            argMax(e.metadata_values, tuple(e.start_time, e.event_ts, e.span_id)) AS metadata_values,
            groupUniqArrayArray(mapKeys(e.tool_definitions)) AS tool_names,
            groupUniqArrayArray(e.tool_call_names) AS called_tool_names,
            sum(length(e.tool_calls)) AS tool_calls_count
        FROM events_full AS e
        WHERE (e.project_id = {param1:String})
            AND (session_id IN ({param2:Array(String)}))
            AND (start_time >= ({param3:DateTime64(3)} - toIntervalDay(2)))
            AND (session_id IN (
                SELECT m.session_id
                FROM events_full AS m
                WHERE (m.project_id = {param1:String})
                    AND (m.start_time >= ({param3:DateTime64(3)} - toIntervalDay(2)))
                    AND (m.session_id != '')
                    AND (has(m.metadata_names, {param4:String}) AND like(arrayStringConcat(m.metadata_values), {param5:String}) AND (position(m.metadata_values[indexOf(m.metadata_names, {param4:String})], {param6:String}) > 0))
            ))
            AND (session_id != '')
        GROUP BY session_id
    )
SELECT count(s.session_id) AS count
FROM session_data AS s
WHERE has(s.metadata_names, {param7:String})
    AND like(arrayStringConcat(s.metadata_values), {param8:String})
    AND (position(s.metadata_values[indexOf(s.metadata_names, {param7:String})], {param9:String}) > 0)
    AND (hasAny({param10:Array(String)}, s.tool_names) = true)
    AND (session_id IN ({param11:Array(String)}))
    AND (min_timestamp >= {param12:DateTime64(3, 'UTC')})",
  },
]
`;

exports[`golden: sessions table aggregation family > getSessionsTableFromEvents filter=none 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": 50,
    },
    "route": "unknown",
    "sql": "WITH
    session_data AS
    (
        SELECT
            e.session_id AS session_id,
            max(e.start_time) AS max_timestamp,
            min(e.start_time) AS min_timestamp,
            groupUniqArray(e.trace_id) AS trace_ids,
            groupUniqArrayIf(e.user_id, ((e.user_id IS NOT NULL) AND (e.user_id != ''))) AS user_ids,
            uniq(e.trace_id) AS trace_count,
            groupUniqArrayArrayIf(e.tags, notEmpty(e.tags)) AS trace_tags,
            argMaxIf(e.environment, e.event_ts, e.environment != '') AS environment,
            uniqIf(e.span_id, e.parent_span_id != '') AS total_observations,
            dateDiff('second', min(e.start_time), max(if(isNull(e.end_time), e.start_time, e.end_time))) AS duration,
            sumMap(e.usage_details) AS session_usage_details,
            sumMap(e.cost_details) AS session_cost_details,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(e.cost_details)))
            ) AS session_input_cost,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(e.cost_details)))
            ) AS session_output_cost,
            sumMap(e.cost_details)['total'] AS session_total_cost,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(e.usage_details)))
            ) AS session_input_usage,
            arraySum(
                mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(e.usage_details)))
            ) AS session_output_usage,
            sumMap(e.usage_details)['total'] AS session_total_usage
        FROM events_core AS e
        WHERE (e.project_id = {param1:String})
            AND (session_id != '')
            AND (session_id IN (
                WITH
                    page_sessions AS
                    (
                        SELECT
                            e.session_id AS session_id,
                            max(e.start_time) AS max_timestamp,
                            min(e.start_time) AS min_timestamp,
                            groupUniqArray(e.trace_id) AS trace_ids,
                            groupUniqArrayIf(e.user_id, ((e.user_id IS NOT NULL) AND (e.user_id != ''))) AS user_ids,
                            uniq(e.trace_id) AS trace_count,
                            groupUniqArrayArrayIf(e.tags, notEmpty(e.tags)) AS trace_tags,
                            argMaxIf(e.environment, e.event_ts, e.environment != '') AS environment,
                            uniqIf(e.span_id, e.parent_span_id != '') AS total_observations,
                            dateDiff(
                                'second',
                                min(e.start_time),
                                max(if(isNull(e.end_time), e.start_time, e.end_time))
                            ) AS duration,
                            sumMap(e.usage_details) AS session_usage_details,
                            sumMap(e.cost_details) AS session_cost_details,
                            arraySum(
                                mapValues(
                                    mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(e.cost_details))
                                )
                            ) AS session_input_cost,
                            arraySum(
                                mapValues(
                                    mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(e.cost_details))
                                )
                            ) AS session_output_cost,
                            sumMap(e.cost_details)['total'] AS session_total_cost,
                            arraySum(
                                mapValues(
                                    mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(e.usage_details))
                                )
                            ) AS session_input_usage,
                            arraySum(
                                mapValues(
                                    mapFilter(
                                        x -> (positionCaseInsensitive(x.1, 'output') > 0),
                                        sumMap(e.usage_details)
                                    )
                                )
                            ) AS session_output_usage,
                            sumMap(e.usage_details)['total'] AS session_total_usage
                        FROM events_core AS e
                        WHERE (e.project_id = {param1:String})
                            AND (session_id != '')
                        GROUP BY session_id
                    )
                SELECT s.session_id
                FROM page_sessions AS s
                LIMIT {param2:Int32}
            ))
        GROUP BY session_id
    )
SELECT
    s.session_id,
    s.max_timestamp,
    s.min_timestamp,
    s.trace_ids,
    s.user_ids,
    s.trace_count,
    s.trace_tags,
    s.environment,
    s.total_observations,
    s.duration,
    s.session_usage_details,
    s.session_cost_details,
    s.session_input_cost,
    s.session_output_cost,
    s.session_total_cost,
    s.session_input_usage,
    s.session_output_usage,
    s.session_total_usage
FROM session_data AS s",
  },
]
`;

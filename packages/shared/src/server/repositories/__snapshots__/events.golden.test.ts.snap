exports[`golden: events simple aggregates family > getSessionMetricsFromEvents fields=all 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "golden-session",
        "golden-session-b",
      ],
      "param3": 2,
    },
    "route": "unknown",
    "sql": "SELECT
    e.session_id AS session_id,
    max(e.start_time) AS max_timestamp,
    min(e.start_time) AS min_timestamp,
    groupUniqArray(e.trace_id) AS trace_ids,
    groupUniqArrayIf(e.user_id, ((e.user_id IS NOT NULL) AND (e.user_id != ''))) AS user_ids,
    uniq(e.trace_id) AS trace_count,
    groupUniqArrayArrayIf(e.tags, notEmpty(e.tags)) AS trace_tags,
    argMaxIf(e.environment, e.event_ts, e.environment != '') AS environment,
    uniqIf(e.span_id, e.parent_span_id != '') AS total_observations,
    dateDiff('second', min(e.start_time), max(if(isNull(e.end_time), e.start_time, e.end_time))) AS duration,
    sumMap(e.usage_details) AS session_usage_details,
    sumMap(e.cost_details) AS session_cost_details,
    arraySum(
        mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(e.cost_details)))
    ) AS session_input_cost,
    arraySum(
        mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(e.cost_details)))
    ) AS session_output_cost,
    sumMap(e.cost_details)['total'] AS session_total_cost,
    arraySum(
        mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'input') > 0), sumMap(e.usage_details)))
    ) AS session_input_usage,
    arraySum(
        mapValues(mapFilter(x -> (positionCaseInsensitive(x.1, 'output') > 0), sumMap(e.usage_details)))
    ) AS session_output_usage,
    sumMap(e.usage_details)['total'] AS session_total_usage
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.is_deleted = 0)
    AND (session_id IN ({param2:Array(String)}))
    AND (session_id != '')
GROUP BY session_id
LIMIT {param3:Int64}",
  },
]
`;


    e.tool_calls AS tool_calls,
    e.tool_call_names AS tool_call_names,
    mapFromArrays(arrayReverse(e.metadata_names), arrayReverse(e.metadata_values)) AS metadata,
    input,
    output,
    e.project_id,
    e.trace_id,
    e.environment,
    e.span_id,
    e.parent_span_id,
    e.start_time,
    e.event_ts,
    e.type,
    e.name,
    e.level,
    e.status_message
FROM events_full AS e
WHERE (e.project_id IN ({param1:Array(String)})) AND (e.trace_id IN ({param2:Array(String)})) AND ((e.project_id, e.trace_id) IN ({param3:Array(Tuple(String, String))})) AND (xxHash32(e.trace_id) IN (
    SELECT arrayJoin(arrayMap(id -> xxHash32(id), {param2:Array(String)}))
)) AND (
    e.start_time >= fromUnixTimestamp64Milli({param4:Int64})
) AND (e.start_time <= fromUnixTimestamp64Milli({param5:Int64})) AND arrayExists((group_project_id, group_trace_ids, min_ms, max_ms) -> ((e.project_id = group_project_id) AND has(group_trace_ids, e.trace_id) AND ((e.start_time >= fromUnixTimestamp64Milli(min_ms)) AND (e.start_time <= fromUnixTimestamp64Milli(max_ms)))), {param6:Array(String)}, {param7:Array(Array(String))}, {param8:Array(Int64)}, {param9:Array(Int64)})
ORDER BY
    e.project_id ASC,
    e.trace_id ASC",
  },
]
`;


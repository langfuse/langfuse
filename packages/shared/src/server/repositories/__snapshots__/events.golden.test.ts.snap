    t.environment,
    t.public,
    t.bookmarked,
    t.tags,
    t.session_id,
    t.timestamp,
    t.created_at,
    t.updated_at,
    map() AS metadata,
    0 AS is_deleted,
    '' AS input,
    '' AS output
FROM event_traces AS t
ORDER BY t.timestamp DESC
LIMIT 1",
  },
]

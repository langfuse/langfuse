    t.public,
    t.bookmarked,
    t.tags,
    t.session_id,
    t.timestamp,
    t.created_at,
    t.updated_at,
    map() AS metadata,
    0 AS is_deleted,
    '' AS input,
    '' AS output
FROM traces AS t
ORDER BY t.timestamp DESC
LIMIT {param3:Int64}",
  },
]
`;


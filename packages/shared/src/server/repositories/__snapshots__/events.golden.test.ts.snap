            "golden-span-b",
          ],
        },
        TupleParam {
          "values": [
            "golden-trace-b",
            "golden-span-c",
          ],
        },
      ],
      "param6": "golden-session",
      "param7": "2025-11-30 23:59:59.000",
      "param8": "2026-01-01 00:00:01.000",
    },
    "route": "unknown",
    "sql": "SELECT
    e.span_id AS id,
    e.trace_id AS trace_id,
    leftUTF8(e.input, 1000) AS input,
    leftUTF8(e.output, 1000) AS output,
    mapFromArrays(arrayReverse(e.metadata_names), arrayReverse(e.metadata_values)) AS metadata
FROM events_core AS e
WHERE (e.project_id = {param1:String}) AND (e.is_deleted = {param2:UInt8}) AND (e.span_id IN ({param3:Array(String)})) AND (e.trace_id IN ({param4:Array(String)})) AND ((e.trace_id, e.span_id) IN ({param5:Array(Tuple(String, String))})) AND (e.trace_id IN (
    SELECT trace_id
    FROM events_core
    WHERE (project_id = {param1:String}) AND (events_core.is_deleted = {param2:UInt8}) AND (trace_id IN ({param4:Array(String)}))
    GROUP BY trace_id
    HAVING argMaxIf(session_id, event_ts, session_id != '') = {param6:String}
)) AND (e.start_time >= {param7:DateTime64(6)}) AND (e.start_time <= {param8:DateTime64(6)})",
  },
]
`;


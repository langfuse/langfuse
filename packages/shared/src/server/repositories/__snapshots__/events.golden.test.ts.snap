    mapFromArrays(
        arrayReverse(e.metadata_names),
        arrayReverse(arrayMap(v -> leftUTF8(v, 5000), e.metadata_values))
    ) AS metadata
FROM events_full AS e
WHERE (e.project_id = {param1:String}) AND (e.is_deleted = {param2:UInt8}) AND (e.span_id IN ({param3:Array(String)})) AND (e.trace_id IN ({param4:Array(String)})) AND ((e.trace_id, e.span_id) IN ({param5:Array(Tuple(String, String))})) AND (e.start_time >= {param6:DateTime64(6)}) AND (e.start_time <= {param7:DateTime64(6)})",

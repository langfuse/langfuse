    e.prompt_version AS prompt_version,
    e.created_at AS created_at,
    e.updated_at AS updated_at,
    e.event_ts
FROM events_core AS e
WHERE (e.project_id = {param1:String}) AND (span_id = {param2:String}) AND (toStartOfMinute(start_time) = toStartOfMinute({param3:DateTime64(3)})) AND (start_time >= ({param4:DateTime64(3)} - toIntervalDay(2))) AND (type = {param5:String}) AND (trace_id = {param6:String})
ORDER BY
    start_time DESC,

exports[`golden: events point-reads & existence family > getAgentGraphDataFromEventsTable 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "golden-trace",
      "param3": "2026-01-01 00:00:00.000",
      "param4": "2026-01-01 01:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT
    e.span_id AS id,
    e.parent_span_id AS parent_observation_id,
    e.type AS type,
    e.name AS name,
    e.start_time AS start_time,
    e.end_time AS end_time,
    mapFromArrays(arrayReverse(e.metadata_names), arrayReverse(e.metadata_values))['langgraph_node'] AS node,
    mapFromArrays(arrayReverse(e.metadata_names), arrayReverse(e.metadata_values))['langgraph_step'] AS step
FROM events_core AS e
WHERE (e.project_id = {param1:String}) AND (e.trace_id = {param2:String}) AND (e.start_time >= {param3:DateTime64(3)}) AND (e.start_time <= {param4:DateTime64(3)})",
  },
]
`;


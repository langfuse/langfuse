exports[`golden: events export streams family > getEventsForBlobStorageExport fieldGroups=default 1`] = `
[
  {
    "fn": "queryClickhouseStream",
    "params": {
      "param1": "golden-project",
      "param2": 0,
      "param3": "2025-12-01 00:00:00.000",
      "param4": "2026-01-02 00:00:00.000",
    },
    "route": "blob_export",
    "sql": "SELECT
    e.span_id AS id,
    e.trace_id AS trace_id,
    e.project_id AS project_id,
    e.environment AS environment,
    e.type AS type,
    e.parent_span_id AS parent_observation_id,
    toBool((e.parent_span_id = '') OR (e.is_app_root = true)) AS is_root_observation,
    e.name AS name,
    e.level AS level,
    e.status_message AS status_message,
    e.version AS version,
    e.bookmarked AS bookmarked,
    e.public AS public,
    e.user_id AS user_id,
    e.session_id AS session_id,
    ifNull(
        coalesce(
            nullIf(e.trace_name, ''),
            if((e.parent_span_id = '') OR (e.is_app_root = true), nullIf(e.name, ''), NULL)
        ),
        ''
    ) AS trace_name,
    e.start_time AS start_time,
    e.end_time AS end_time,
    e.completion_start_time AS completion_start_time,
    e.created_at AS created_at,
    e.updated_at AS updated_at,
    e.provided_model_name AS provided_model_name,
    e.model_parameters AS model_parameters,
    e.usage_details AS usage_details,
    e.cost_details AS cost_details,
    e.total_cost AS total_cost,
    e.prompt_id AS prompt_id,
    e.prompt_name AS prompt_name,
    e.prompt_version AS prompt_version,
    e.tool_definitions AS tool_definitions,
    e.tool_calls AS tool_calls,

[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": 0,
      "param3": "2025-12-25 00:00:00.000",
      "param4": "otel",
      "param5": [
        "langfuse-internal-ai-sdk",
        "langfuse-internal-otel-writer",

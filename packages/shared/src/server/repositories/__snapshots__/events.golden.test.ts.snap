exports[`golden: events export streams family > getEventsForBlobStorageExport fieldGroups=basic 1`] = `
[
  {
    "fn": "queryClickhouseStream",
    "params": {
      "param1": "golden-project",
      "param2": "2025-12-01 00:00:00.000",
      "param3": "2026-01-02 00:00:00.000",
    },
    "route": "blob_export",
    "sql": "SELECT
    e.span_id AS id,
    e.trace_id AS trace_id,
    e.project_id AS project_id,
    e.environment AS environment,
    e.type AS type,
    e.parent_span_id AS parent_observation_id,
    toBool(((e.parent_span_id = '') OR (e.is_app_root = true))) AS is_root_observation,
    e.name AS name,
    e.level AS level,
    e.status_message AS status_message,
    e.version AS version,
    e.bookmarked AS bookmarked,
    e.public AS public,
    e.user_id AS user_id,
    e.session_id AS session_id,
    e.start_time AS start_time,
    e.end_time AS end_time
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.is_deleted = 0)
    AND (e.start_time >= {param2:DateTime64(6)})
    AND (e.start_time < {param3:DateTime64(6)})
LIMIT 1 BY
    e.span_id,
    e.project_id",
  },
]
`;


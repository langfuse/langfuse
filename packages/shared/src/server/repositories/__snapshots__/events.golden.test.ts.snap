exports[`golden: events IO payload reads family > getObservationFullIOForSessionFromEventsTable 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "golden-session",
      "param3": "golden-trace",
      "param4": "golden-span",
      "param5": "2025-12-31 23:59:59.000",
      "param6": "2026-01-01 00:00:01.000",
    },
    "route": "unknown",
    "sql": "SELECT
    latest.id,
    latest.input,
    latest.output,
    latest.metadata
FROM
(
    SELECT
        e.span_id AS id,
        e.input AS input,
        e.output AS output,
        mapFromArrays(arrayReverse(e.metadata_names), arrayReverse(e.metadata_values)) AS metadata,
        e.is_deleted AS is_deleted
    FROM events_full AS e
    WHERE (e.project_id = {param1:String})
        AND (e.session_id = {param2:String})
        AND (xxHash32(e.trace_id) = xxHash32({param3:String}))
        AND (e.trace_id = {param3:String})
        AND (e.span_id = {param4:String})
        AND (e.start_time >= {param5:DateTime64(6)})
        AND (e.start_time <= {param6:DateTime64(6)})
    ORDER BY e.event_ts DESC
    LIMIT 1
) AS latest
WHERE latest.is_deleted = 0",
  },
]
`;


exports[`golden: events metadata map and session resolution > getObservationsV2FromEventsTableForPublicApi fields=core+metadata expandMetadataKeys=set 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": 51,
    },
    "route": "unknown",
    "sql": "WITH
    base AS
    (
        SELECT
            e.span_id AS id,
            e.trace_id AS trace_id,
            e.project_id AS project_id,
            e.type AS type,
            e.parent_span_id AS parent_observation_id,
            e.start_time AS start_time,
            e.end_time AS end_time
        FROM events_core AS e
        WHERE e.project_id = {param1:String}
        ORDER BY
            e.project_id DESC,
            toStartOfMinute(e.start_time) DESC,
            e.start_time DESC,
            xxHash32(e.trace_id) DESC,
            e.span_id DESC
        LIMIT {param2:Int32}
    ),
    io AS
    (
        SELECT
            e.span_id AS _io_id,
            e.trace_id AS _io_trace_id,
            e.start_time AS _io_start_time,
            mapFromArrays(arrayReverse(e.metadata_names), arrayReverse(e.metadata_values)) AS metadata
        FROM events_full AS e
        WHERE (e.project_id = {param1:String}) AND (e.start_time >= (((
            SELECT (min(start_time), max(start_time))
            FROM base
        )).1)) AND (e.start_time <= (((
            SELECT (min(start_time), max(start_time))
            FROM base
        )).2)) AND ((e.start_time, e.trace_id, e.span_id) IN (
            SELECT
                start_time,
                trace_id,
                id
            FROM base
        ))
    )
SELECT
    b.id AS id,
    b.trace_id AS trace_id,
    b.start_time AS start_time,
    b.end_time AS end_time,
    b.project_id AS project_id,
    b.parent_observation_id AS parent_observation_id,
    b.type AS type,
    i.metadata AS metadata
FROM base AS b
ANY LEFT JOIN io AS i ON (b.start_time = i._io_start_time) AND (b.trace_id = i._io_trace_id) AND (b.id = i._io_id)
ORDER BY
    b.start_time DESC,
    xxHash32(b.trace_id) DESC,
    b.id DESC",
  },
]
`;


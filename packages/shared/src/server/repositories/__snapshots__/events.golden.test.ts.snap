[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "golden-span",
        "golden-span-b",
        "golden-span-c",
      ],
      "param3": [
        "golden-trace",
        "golden-trace-b",
      ],
      "param4": [
        TupleParam {
          "values": [
            "golden-trace",
            "golden-span",
          ],
        },
        TupleParam {
          "values": [
            "golden-trace",
            "golden-span-b",
          ],
        },
        TupleParam {
          "values": [
            "golden-trace-b",
            "golden-span-c",
          ],
        },
      ],
      "param5": "golden-session",
      "param6": "2025-11-30 23:59:59.000",
      "param7": "2026-01-01 00:00:01.000",
    },
    "route": "unknown",
    "sql": "SELECT
    e.span_id AS id,
    e.trace_id AS trace_id,
    leftUTF8(e.input, 1000) AS input,
    leftUTF8(e.output, 1000) AS output,
    mapFromArrays(arrayReverse(e.metadata_names), arrayReverse(e.metadata_values)) AS metadata
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.is_deleted = 0)
    AND (e.span_id IN ({param2:Array(String)}))
    AND (e.trace_id IN ({param3:Array(String)}))
    AND ((e.trace_id, e.span_id) IN ({param4:Array(Tuple(String, String))}))
    AND (e.trace_id IN (
        SELECT trace_id
        FROM events_core AS events
        WHERE (events.project_id = {param1:String})
            AND (events.is_deleted = 0)
            AND (trace_id IN ({param3:Array(String)}))
        GROUP BY trace_id
        HAVING argMaxIf(session_id, event_ts, session_id != '') = {param5:String}
    ))
    AND (e.start_time >= {param6:DateTime64(6)})
    AND (e.start_time <= {param7:DateTime64(6)})",
  },
]
`;


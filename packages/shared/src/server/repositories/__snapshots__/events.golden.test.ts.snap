exports[`golden: events point-reads & existence family > getLastTraceTimestampsByProjectsFromEventsTable projectIds=many 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": [
        "golden-project",
        "golden-project-b",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    project_id,
    max(start_time) AS last_trace_at
FROM events_core
WHERE (project_id IN ({param1:Array(String)})) AND (start_time >= (now() - toIntervalDay(30))) AND (is_deleted = 0)
GROUP BY project_id",
  },
]
`;


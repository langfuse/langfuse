                groupUniqArrayIf(e.span_id, ((e.span_id != '') AND (e.span_id != concat('t-', e.trace_id))))
            ) AS observation_count,
            argMaxIf(e.bookmarked, e.event_ts, e.parent_span_id = '') AS bookmarked,
            max(e.public) AS public,
            argMaxIf(e.experiment_item_id, e.event_ts, e.experiment_item_id != '') AS experiment_item_id,
            sumMap(e.usage_details) AS usage_details,
            sumMap(e.cost_details) AS cost_details,
            multiIf(
                arrayExists(x -> (x = 'ERROR'), groupArray(e.level)),
                'ERROR',
                arrayExists(x -> (x = 'WARNING'), groupArray(e.level)),
                'WARNING',
                arrayExists(x -> (x = 'DEFAULT'), groupArray(e.level)),
                'DEFAULT',
                'DEBUG'
            ) AS aggregated_level,
            countIf(e.level = 'WARNING') AS warning_count,
            countIf(e.level = 'ERROR') AS error_count,
            countIf(e.level = 'DEFAULT') AS default_count,
            countIf(e.level = 'DEBUG') AS debug_count,
            arraySort(groupUniqArrayArrayIf(e.tags, notEmpty(e.tags))) AS tags,
            argMaxIf(e.release, e.event_ts, e.release != '') AS release,
            argMaxIf(e.evaluator_id, e.event_ts, e.evaluator_id != '') AS evaluator_id,
            argMaxIf(e.evaluation_rule_id, e.event_ts, e.evaluation_rule_id != '') AS evaluation_rule_id,
            any(e.experiment_id) AS experiment_id
        FROM events_core AS e
        WHERE (e.project_id = {param1:String})
            AND (e.is_deleted = 0)
            AND (trace_id IN ({param2:Array(String)}))
        GROUP BY
            trace_id,
            project_id
        ORDER BY timestamp DESC
    )
SELECT
    t.id,
    t.name,
    t.user_id,
    t.release,
    t.version,
    t.project_id,
    t.environment,
    t.public,
    t.bookmarked,
    t.tags,
    t.session_id,
    t.timestamp,
    t.created_at,
    t.updated_at,
    t.metadata,
    0 AS is_deleted,
    leftUTF8(t.input, 1000) AS input,
    leftUTF8(t.output, 1000) AS output
FROM event_traces AS t
ORDER BY t.timestamp DESC
LIMIT 1",
  },
]
`;

exports[`golden: events point-reads & existence family > getTraceMetadataByIdsFromEvents traceIds=empty 1`] = `[]`;

exports[`golden: events point-reads & existence family > getTraceMetadataByIdsFromEvents traceIds=set 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "golden-trace",
        "golden-trace-b",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    e.trace_id AS id,
    coalesce(
        nullIf(e.trace_name, ''),
        if(((e.parent_span_id = '') OR (e.is_app_root = true)), nullIf(e.name, ''), NULL)
    ) AS name,
    e.user_id AS user_id,
    e.tags AS tags
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.is_deleted = 0)
    AND (coalesce(nullIf(e.trace_name, ''), if(((e.parent_span_id = '') OR (e.is_app_root = true)), nullIf(e.name, ''), NULL)) IS NOT NULL)
    AND (e.trace_id IN ({param2:Array(String)}))
LIMIT 1 BY e.trace_id",
  },
]
`;


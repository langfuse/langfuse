    mapFromArrays(
        arrayReverse(e.metadata_names),
        arrayReverse(arrayMap(v -> leftUTF8(v, 5000), e.metadata_values))
    ) AS metadata
FROM events_full AS e
WHERE (e.project_id = {param1:String})
    AND (e.is_deleted = 0)
    AND (e.span_id IN ({param2:Array(String)}))
    AND (e.trace_id IN ({param3:Array(String)}))
    AND ((e.trace_id, e.span_id) IN ({param4:Array(Tuple(String, String))}))
    AND (e.start_time >= {param5:DateTime64(6)})
    AND (e.start_time <= {param6:DateTime64(6)})",
  },
]
`;


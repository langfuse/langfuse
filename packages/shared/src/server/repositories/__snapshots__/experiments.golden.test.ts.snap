// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden: experiments legacy list reads > getExperimentItemsBatchIO 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": 1000,
      "param2": "golden-project",
      "param3": [
        "golden-experiment",
        "golden-experiment-b",
      ],
      "param4": [
        "golden-item",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    leftUTF8(input, 1000) AS input,
    leftUTF8(output, 1000) AS output,
    leftUTF8(e.experiment_item_expected_output, {param1:UInt32}) AS expected_output,
    e.experiment_item_id AS item_id,
    e.experiment_id AS experiment_id
FROM events_core AS e
WHERE (e.project_id = {param2:String})
    AND (e.experiment_id IN ({param3:Array(String)}))
    AND (e.experiment_id != '')
    AND (e.experiment_item_id IN ({param4:Array(String)}))
    AND (e.experiment_item_root_span_id = e.span_id)
ORDER BY
    e.project_id DESC,
    toStartOfMinute(e.start_time) DESC,
    e.start_time DESC
LIMIT 1 BY
    e.experiment_item_id,
    e.experiment_id",
  },
]
`;

exports[`golden: experiments legacy list reads > getExperimentItemsFromEvents 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "golden-experiment",
      "param3": "golden-experiment-b",
      "param4": 50,
    },
    "route": "unknown",
    "sql": "SELECT
    e.experiment_item_id AS item_id,
    min(e.start_time) AS start_time
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.span_id = e.experiment_item_root_span_id)
    AND ((e.experiment_id = {param2:String}) OR (e.experiment_id = {param3:String}))
GROUP BY e.experiment_item_id
ORDER BY e.experiment_item_id ASC
LIMIT {param4:Int32}",
  },
]
`;

exports[`golden: experiments legacy list reads > getExperimentItemsFromEvents filter=level 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "golden-experiment",
        "golden-experiment-b",
      ],
      "param3": "golden-experiment",
      "param4": "golden-experiment-b",
      "param5": [
        "ERROR",
      ],
      "param6": 50,
    },
    "route": "unknown",
    "sql": "WITH item_levels AS
    (
        SELECT
            e.experiment_id AS experiment_id,
            e.experiment_item_id AS experiment_item_id,
            multiIf(
                countIf(e.level = 'ERROR') > 0,
                'ERROR',
                countIf(e.level = 'WARNING') > 0,
                'WARNING',
                countIf(e.level = 'DEFAULT') > 0,
                'DEFAULT',
                'DEBUG'
            ) AS aggregated_level
        FROM events_core AS e
        WHERE (e.project_id = {param1:String})
            AND (e.experiment_id IN ({param2:Array(String)}))
            AND (e.experiment_id != '')
        GROUP BY
            e.experiment_id,
            e.experiment_item_id
    )
SELECT
    e.experiment_item_id AS item_id,
    min(e.start_time) AS start_time
FROM events_core AS e
LEFT JOIN item_levels AS il ON (il.experiment_id = e.experiment_id) AND (il.experiment_item_id = e.experiment_item_id)
WHERE (e.project_id = {param1:String})
    AND (e.span_id = e.experiment_item_root_span_id)
    AND ((e.experiment_id = {param3:String}) OR ((e.experiment_id = {param4:String}) AND (il.aggregated_level IN ({param5:Array(String)}))))
GROUP BY e.experiment_item_id
ORDER BY e.experiment_item_id ASC
LIMIT {param6:Int32}",
  },
]
`;

exports[`golden: experiments legacy list reads > getExperimentNamesFromEvents 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": 1000,
    },
    "route": "unknown",
    "sql": "SELECT
    any(e.experiment_name) AS experimentName,
    e.experiment_id AS experimentId,
    nullIf(any(e.experiment_dataset_id), '') AS datasetId,
    min(e.start_time) AS startTime
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.experiment_name IS NOT NULL)
    AND (length(e.experiment_name) > 0)
GROUP BY e.experiment_id
ORDER BY min(e.start_time) DESC
LIMIT {param2:Int32}",
  },
]
`;

exports[`golden: experiments simple aggregates family > getDatasetExperimentMetricsFromEvents 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "golden-dataset",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    experiment_dataset_id,
    count() AS count_dataset_runs,
    max(start_time) AS last_run_at
FROM
(
    SELECT
        e.experiment_id AS experiment_id,
        nullIf(any(e.experiment_dataset_id), '') AS experiment_dataset_id,
        min(e.start_time) AS start_time
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.experiment_id != '')
        AND (e.experiment_dataset_id IN ({param2:Array(String)}))
    GROUP BY
        e.project_id,
        e.experiment_id
) AS experiments
GROUP BY experiment_dataset_id",
  },
]
`;

exports[`golden: experiments simple aggregates family > getExperimentMetricsFromEvents experimentIds=empty 1`] = `[]`;

exports[`golden: experiments simple aggregates family > getExperimentMetricsFromEvents experimentIds=set 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "golden-experiment",
        "golden-experiment-b",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    e.experiment_id AS experiment_id,
    sum(e.total_cost) AS total_cost,
    avgIf(
        dateDiff('millisecond', e.start_time, e.end_time),
        (e.span_id = e.experiment_item_root_span_id) AND (e.end_time IS NOT NULL)
    ) AS latency_avg
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.is_deleted = 0)
    AND (e.experiment_id IN ({param2:Array(String)}))
    AND (e.experiment_id != '')
GROUP BY
    e.project_id,
    e.experiment_id",
  },
]
`;

exports[`golden: experiments simple aggregates family > getExperimentsCountFromEvents filter=experimentIds+startTime 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": [
        "golden-experiment",
        "golden-experiment-b",
      ],
      "param3": "2025-12-01 00:00:00.000",
      "param4": [
        "golden-experiment",
        "golden-experiment-b",
      ],
      "param5": "2025-12-01 00:00:00.000",
    },
    "route": "unknown",
    "sql": "SELECT count() AS count
FROM
(
    SELECT e.experiment_id AS experiment_id
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.experiment_id IN ({param2:Array(String)}))
        AND (e.start_time >= ({param3:DateTime64(3)} - toIntervalDay(2)))
        AND (e.experiment_id != '')
        AND ((e.experiment_id IN ({param4:Array(String)})) AND (e.start_time >= {param5:DateTime64(3, 'UTC')}))
    GROUP BY
        e.project_id,
        e.experiment_id
) AS matched_experiments",
  },
]
`;

exports[`golden: experiments simple aggregates family > getExperimentsFromEvents filter=none 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": 50,
    },
    "route": "unknown",
    "sql": "SELECT
    e.experiment_id AS experiment_id,
    any(e.experiment_name) AS experiment_name,
    anyIf(e.experiment_description, e.span_id = e.experiment_item_root_span_id) AS experiment_description,
    nullIf(any(e.experiment_dataset_id), '') AS experiment_dataset_id,
    min(e.start_time) AS start_time,
    uniq(e.experiment_item_id) AS item_count,
    uniqIf(e.experiment_item_id, e.level = 'ERROR') AS error_count,
    groupUniqArrayIf(tuple(e.prompt_name, e.prompt_version), e.prompt_name != '') AS prompts,
    any(mapFromArrays(e.experiment_metadata_names, e.experiment_metadata_values)) AS experiment_metadata
FROM events_core AS e
WHERE (e.project_id = {param1:String})
    AND (e.experiment_id != '')
GROUP BY
    e.project_id,
    e.experiment_id
LIMIT {param2:Int32}",
  },
]
`;

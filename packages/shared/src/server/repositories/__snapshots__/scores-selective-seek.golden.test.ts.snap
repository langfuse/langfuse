exports[`scores selective-seek: emitted SQL > eligible → seek phase present (R2) > rows: name IN 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "seek-project",
      "param2": "seek-project",
      "param3": [
        "n1",
      ],
      "param4": [
        "NUMERIC",
        "BOOLEAN",
        "CATEGORICAL",
        "TEXT",
      ],
    },
    "route": "unknown",
    "sql": "SELECT
    s.id,
    s.project_id,
    s.environment,
    s.name,
    s.value,
    s.string_value,
    s.timestamp,
    s.source,
    s.data_type,
    s.comment,
    s.evaluator_id,
    s.trace_id,
    s.session_id,
    s.dataset_run_id,
    s.observation_id,
    s.author_user_id,
    s.created_at,
    s.updated_at,
    s.config_id,
    s.queue_id,
    s.execution_trace_id,
    s.ingestion_api_key,
    s.ingestion_sdk_name,
    s.ingestion_sdk_version,
    s.is_deleted,
    s.event_ts,
    length(mapKeys(s.metadata)) > 0 AS has_metadata
FROM
(
    SELECT *
    FROM scores AS s
    WHERE (s.project_id = {param1:String}) AND ((s.project_id, toDate(s.timestamp), s.name, s.id) IN (
        SELECT DISTINCT
            s.project_id,
            toDate(s.timestamp),
            s.name,
            s.id
        FROM scores AS s
        WHERE (s.project_id = {param1:String}) AND (project_id = {param2:String}) AND (s.name IN ({param3:Array(String)}))
    ))
    ORDER BY s.event_ts DESC
    LIMIT 1 BY
        s.project_id,
        toDate(s.timestamp),
        s.name,
        s.id
) AS s
WHERE (s.data_type IN ({param4:Array(String)})) AND (project_id = {param2:String}) AND (s.name IN ({param3:Array(String)}))
ORDER BY s.timestamp DESC",
  },
]
`;


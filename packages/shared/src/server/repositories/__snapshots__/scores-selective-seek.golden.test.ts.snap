// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`scores selective-seek: emitted SQL > eligible → seek phase present (R2) > count: name IN 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "seek-project",
      "param2": "seek-project",
      "param3": [
        "n1",
      ],
      "param4": [
        "NUMERIC",
        "BOOLEAN",
        "CATEGORICAL",
        "TEXT",
      ],
    },
    "route": "unknown",
    "sql": "SELECT count(*) AS count
FROM
(
    SELECT
        s.id,
        s.project_id,
        s.name,
        argMax(s.timestamp, s.event_ts) AS timestamp,
        argMax(s.environment, s.event_ts) AS environment,
        argMax(s.trace_id, s.event_ts) AS trace_id,
        argMax(s.observation_id, s.event_ts) AS observation_id,
        argMax(s.session_id, s.event_ts) AS session_id,
        argMax(s.evaluator_id, s.event_ts) AS evaluator_id,
        argMax(s.evaluation_rule_id, s.event_ts) AS evaluation_rule_id,
        argMax(s.value, s.event_ts) AS value,
        argMax(s.source, s.event_ts) AS source,
        argMax(s.comment, s.event_ts) AS comment,
        argMax(s.author_user_id, s.event_ts) AS author_user_id,
        argMax(s.data_type, s.event_ts) AS data_type,
        argMax(s.string_value, s.event_ts) AS string_value,
        argMax(s.metadata, s.event_ts) AS metadata
    FROM scores AS s
    WHERE (s.project_id = {param1:String}) AND ((s.project_id, toDate(s.timestamp), s.name, s.id) IN (
        SELECT DISTINCT
            s.project_id,
            toDate(s.timestamp),
            s.name,
            s.id
        FROM scores AS s
        WHERE (s.project_id = {param1:String}) AND (project_id = {param2:String}) AND (s.name IN ({param3:Array(String)}))
    ))
    GROUP BY
        s.project_id,
        toDate(s.timestamp),
        s.name,
        s.id
) AS s
WHERE (s.data_type IN ({param4:Array(String)})) AND (project_id = {param2:String}) AND (s.name IN ({param3:Array(String)}))",
  },
]
`;


// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden: scores.getAggregatedScoresForPromptsFromEvents > relation=observation time=from+to 1`] = `
{
  "params": {
    "param1": "golden-project",
    "param2": [
      "prompt-a",
      "prompt-b",
    ],
    "param3": "2026-01-01 00:00:00.000",
    "param4": "2026-01-31 23:59:59.000",
  },
  "sql": "WITH
    prompt_events AS
    (
        SELECT
            latest.project_id,
            latest.prompt_id,
            latest.trace_id,
            latest.span_id
        FROM
        (
            SELECT
                e.project_id AS project_id,
                e.prompt_id AS prompt_id,
                e.trace_id AS trace_id,
                e.span_id AS span_id,
                e.is_deleted AS is_deleted
            FROM events_core AS e
            WHERE (e.project_id = {param1:String})
                AND (e.type = 'GENERATION')
                AND (e.prompt_id IN ({param2:Array(String)}))
                AND (e.start_time >= {param3:DateTime64(6)})
                AND (e.start_time <= {param4:DateTime64(6)})
            ORDER BY e.event_ts DESC
            LIMIT 1 BY
                e.span_id,
                e.project_id
        ) AS latest
        WHERE latest.is_deleted = 0
    )
SELECT
    e.prompt_id AS prompt_id,
    s.id AS id,
    s.name AS name,
    s.string_value AS string_value,
    s.value AS value,
    s.source AS source,
    s.data_type AS data_type,
    s.comment AS comment,
    s.timestamp AS timestamp,
    notEmpty(mapKeys(s.metadata)) AS has_metadata
FROM scores AS s
FINAL
INNER JOIN prompt_events AS e ON (s.project_id = e.project_id) AND (s.trace_id = e.trace_id) AND (s.observation_id = e.span_id)
WHERE (s.project_id = {param1:String})
    AND (s.name IS NOT NULL)
    AND (s.data_type IN ('NUMERIC', 'BOOLEAN', 'CATEGORICAL', 'TEXT'))
    AND (s.observation_id IS NOT NULL)
    AND ((s.trace_id, s.observation_id) IN (
        SELECT
            trace_id,
            span_id
        FROM prompt_events
    ))
GROUP BY
    e.prompt_id,
    s.id,
    s.name,
    s.string_value,
    s.value,
    s.source,
    s.data_type,
    s.comment,
    s.timestamp,
    s.metadata",
}
`;


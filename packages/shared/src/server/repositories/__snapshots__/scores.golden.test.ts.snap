exports[`golden: scores.getScoresForExperimentItems > experimentIds set 1`] = `
{
  "params": {
    "param1": "golden-project",
    "param2": [
      "exp-a",
      "exp-b",
    ],
  },
  "sql": "SELECT
    s.id AS id,
    s.timestamp AS timestamp,
    s.project_id AS project_id,
    s.environment AS environment,
    s.trace_id AS trace_id,
    s.session_id AS session_id,
    s.observation_id AS observation_id,
    s.dataset_run_id AS dataset_run_id,
    s.name AS name,
    s.value AS value,
    s.source AS source,
    s.comment AS comment,
    s.author_user_id AS author_user_id,
    s.config_id AS config_id,
    s.data_type AS data_type,
    s.string_value AS string_value,
    s.queue_id AS queue_id,
    s.execution_trace_id AS execution_trace_id,
    s.created_at AS created_at,
    s.updated_at AS updated_at,
    s.event_ts AS event_ts,
    s.is_deleted AS is_deleted,
    notEmpty(mapKeys(s.metadata)) AS has_metadata,
    e.experiment_id AS experiment_id
FROM
(
    SELECT
        e.project_id,
        e.experiment_id,
        e.trace_id
    FROM events_core AS e
    WHERE (e.project_id = {param1:String})
        AND (e.is_deleted = 0)
        AND (e.experiment_id IN ({param2:Array(String)}))
        AND (e.experiment_id != '')
) AS e
INNER JOIN scores AS s
FINAL ON (e.trace_id = s.trace_id) AND (e.project_id = s.project_id) AND (s.project_id = {param1:String})
WHERE s.data_type IN ('NUMERIC', 'BOOLEAN', 'CATEGORICAL')
ORDER BY s.event_ts DESC
LIMIT 1 BY
    s.id,
    s.project_id,
    e.experiment_id",
}
`;

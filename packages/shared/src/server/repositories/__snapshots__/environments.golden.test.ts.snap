// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden: environments.getEnvironmentsForProject > writeMode=events_only fromTimestamp=set 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
    },
    "route": "environments.getEnvironmentsForProject",
    "sql": "SELECT DISTINCT environment
FROM events_core AS events
WHERE (events.project_id = {param1:String})
    AND (events.is_deleted = 0)
    AND (start_time >= {param2:DateTime64(6)})",
  },
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": "2026-01-01 00:00:00.000",
    },
    "route": "environments.getEnvironmentsForProject",
    "sql": "SELECT DISTINCT environment
FROM scores
WHERE (project_id = {param1:String})
    AND (data_type IN ('NUMERIC', 'BOOLEAN', 'CATEGORICAL', 'TEXT'))
    AND (timestamp >= {param2:DateTime64(3)})",
  },
]
`;


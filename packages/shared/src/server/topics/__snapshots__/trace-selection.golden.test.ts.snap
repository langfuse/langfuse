exports[`golden: topics trace selection > selectTopicTraceRows mode=preview 1`] = `
[
  {
    "fn": "queryClickhouse",
    "params": {
      "param1": "golden-project",
      "param2": true,
      "param3": "2026-01-01 00:00:00.000",
      "param4": "2026-01-02 00:00:00.000",
      "param5": "langfuse",
      "param6": "llm-as-a-judge",
      "param7": 100,
    },
    "route": "topics-trace-selection",
    "sql": "WITH matching_traces AS
    (
        WITH matching_observations AS
            (
                SELECT
                    e.trace_id AS id,
                    e.start_time AS start_time,
                    e.span_id AS span_id,
                    e.event_ts AS event_ts,
                    e.environment AS environment,
                    ifNull(
                        COALESCE(
                            nullIf(e.trace_name, ''),
                            if((e.parent_span_id = '') OR (e.is_app_root = true), nullIf(e.name, ''), NULL)
                        ),
                        ''
                    ) AS trace_name
                FROM events_core AS e
                WHERE (e.project_id = {param1:String})
                    AND ((((e.parent_span_id = '') OR (e.is_app_root = true)) = {param2:Boolean}) AND (e.start_time >= {param3:DateTime64(3, 'UTC')}) AND (e.start_time < {param4:DateTime64(3, 'UTC')}))
                    AND (e.trace_id != '')
            )
        SELECT
            m.id AS id,
            min(m.start_time) AS timestamp,
            max(m.start_time) AS latest_match,
            argMax(m.environment, tuple(m.event_ts, m.span_id, m.environment)) AS environment,
            argMaxIf(m.trace_name, tuple(m.event_ts, m.span_id, m.trace_name), m.trace_name != '') AS name
        FROM matching_observations AS m
        GROUP BY m.id
        HAVING (NOT startsWith(environment, {param5:String}))
            AND (environment != {param6:String})
    )
SELECT
    t.id AS id,
    toUnixTimestamp64Milli(t.timestamp) AS timestampMs,
    count() OVER () AS matchedTraceCount,
    t.name AS name,
    t.environment AS environment
FROM matching_traces AS t
ORDER BY
    t.latest_match DESC,
    t.id ASC
LIMIT {param7:Int32}",
  },
]
`;

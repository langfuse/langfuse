# Copy outside the repository; use this deployment's credentials and endpoints.
# No variable interpolation: values must be complete literals.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
CLICKHOUSE_URL="https://HOST:8443"
CLICKHOUSE_USER="USER"
CLICKHOUSE_PASSWORD="PASSWORD"
CLICKHOUSE_DB="default"
# Single node or ClickHouse Cloud. Self-managed clusters are unsupported here.
CLICKHOUSE_CLUSTER_ENABLED="false"

# OCI Object Storage / S3-compatible configuration.
# General configuration: https://langfuse.com/self-hosting/configuration
# Configure buckets for event uploads, media uploads, and batch exports below.

# ============================================================================
# STORAGE AUTHENTICATION
# ============================================================================

# Prefer OCI-native authentication over static keys. Choose one auth type:
# - instance_principal: OCI Compute with a dynamic group and IAM policies.
# - workload_identity: OKE with OCI Workload Identity configured.
# - resource_principal: OCI services that inject Resource Principal credentials.
# - oci_profile: a local or mounted OCI config file and named profile.
# - session_token: short-lived CLI auth via `oci session authenticate`; for dev use.
# Uncomment both settings to use OCI-native storage. For other providers, leave
# native storage disabled and configure the provider's endpoints and credentials.
# LANGFUSE_USE_OCI_NATIVE_OBJECT_STORAGE=true
# LANGFUSE_OCI_AUTH_TYPE=instance_principal

# Profile and session-token authentication
# Required only for oci_profile / session_token. Mount config files securely;
# avoid including credentials in images or source control.
LANGFUSE_OCI_CONFIG_FILE=__REPLACE_ME__/config
LANGFUSE_OCI_CONFIG_PROFILE=DEFAULT

# Optional CA bundle for Kubernetes/OKE environments that need additional trust.
# NODE_EXTRA_CA_CERTS=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt

# ============================================================================
# OBJECT STORAGE
# ============================================================================

# The examples below use OCI region us-chicago-1. For S3-compatible static-key
# authentication, replace the credential placeholders and inject real secrets at
# runtime from a secret manager (e.g., Kubernetes Secret / OCI Vault). Rotate any
# credentials that were shared or committed. For OCI-native auth, remove/comment
# the *_ACCESS_KEY_ID and *_SECRET_ACCESS_KEY settings.

# Batch exports
LANGFUSE_S3_BATCH_EXPORT_ENABLED=true
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse-bucket
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_REGION=us-chicago-1
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=https://objectstorage.us-chicago-1.oraclecloud.com
# Optional public endpoint when downloads must be accessible outside the cluster.
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=https://objectstorage.us-chicago-1.oraclecloud.com
# Path-style addressing is needed by MinIO and some other S3-compatible providers.
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=__REPLACE_ME__
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=__REPLACE_ME__

# Media uploads
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-bucket
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_MEDIA_UPLOAD_REGION=us-chicago-1
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=https://objectstorage.us-chicago-1.oraclecloud.com
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=__REPLACE_ME__
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=__REPLACE_ME__

# Event uploads
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-bucket
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-chicago-1
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=https://objectstorage.us-chicago-1.oraclecloud.com
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=__REPLACE_ME__
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=__REPLACE_ME__

# Troubleshooting
# - For TLS errors in Kubernetes/OKE, set NODE_EXTRA_CA_CERTS to the correct bundle.
# - For bucket addressing errors with S3-compatible providers, enable path style.
# - For external download errors, use a publicly reachable batch export endpoint.

# ============================================================================
# V4 MIGRATION
# ============================================================================

# Pinned to dual write mode to ensure we cover the tests.
# Write target: `legacy` | `dual` | `events_only`.
LANGFUSE_MIGRATION_V4_WRITE_MODE=dual
# Gate the V4 events_full read paths (UI, tRPC, v2 APIs, observations API).
# Self-hosted `dual` deployments must set this to `true` to offer users the V4
# preview toggle; with `dual` + `false` the preview stays unavailable to users.
LANGFUSE_MIGRATION_V4_ALLOW_PREVIEW_OPT_IN=true
# OTel ingestion behaviour: `dual_write` (SDK-version dispatch) or `direct`.
LANGFUSE_MIGRATION_V4_NATIVE_OTEL_BEHAVIOUR=dual_write
# Keep the WIP historic backfill dormant for local dev / CI. The v4 code default
# is `true`, but the general test suite should not run the backfill underneath it
# (it has a dedicated e2e spec). Set to `true` to exercise the backfill locally.
LANGFUSE_BACKGROUND_MIGRATION_V4_ENABLE_HISTORIC_BACKFILL=false
